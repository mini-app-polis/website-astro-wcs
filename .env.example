# =============================================================================
# wcs.kaianolevine.com — environment variables
# Copy this file to .env and fill in your values for local development.
# Never commit .env — it is in .gitignore.
# In production, set these in the Cloudflare Pages dashboard (all are build-time).
# =============================================================================

# Primary API (api.kaianolevine.com on Railway)
# Sets, live plays, stats, contact form, Spotify playlists
KAIANO_API_BASE_URL=https://api.kaianolevine.com

# Cloudflare Turnstile site key (contact form + survey spam protection)
# Get from: https://dash.cloudflare.com → Turnstile
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACXUS6RYhJCvPzZg

# Clerk authentication (client-side sign-in; the API decides access)
# Get from: https://dashboard.clerk.com
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
