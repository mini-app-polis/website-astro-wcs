# =============================================================================
# wcs.kaianolevine.com — environment variables
# Copy this file to .env and fill in your values for local development.
# Never commit .env — it is in .gitignore.
# In production, set these in Cloudflare Pages dashboard or wrangler.toml.
# =============================================================================

# Primary API (api.kaianolevine.com on Railway)
# Sets, live plays, stats, contact form, Spotify playlists
PUBLIC_API_URL=https://api.kaianolevine.com

# Cloudflare Turnstile site key (contact form + survey spam protection)
# Get from: https://dash.cloudflare.com → Turnstile
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACXUS6RYhJCvPzZg

# Clerk authentication (notes section)
# Get from: https://dashboard.clerk.com
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Your Clerk user ID — the only account with access to /notes
# Get from: Clerk dashboard → Users → your account → User ID
NOTES_ALLOWED_USER_ID=user_...

# Clerk JWT public key for server-side token verification (networkless)
# Get from: Clerk dashboard → API Keys → Show JWT public key → PEM Public Key
CLERK_JWT_KEY=