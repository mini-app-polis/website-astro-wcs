# wcs.kaianolevine.com — the names the site reads. Names only: copy this to
# .env and fill in values for local development; in production they are
# Cloudflare Pages environment variables. All are read at build time and
# baked into the static output, so every one is public. `astro build` stops
# when PUBLIC_API_URL or PUBLIC_TURNSTILE_SITE_KEY is unset; `astro dev`
# runs without them.

# Base URL of api-kaianolevine-com: sets, live plays, stats, the contact
# form, Spotify playlists. Injected into <html data-api-url>, where
# client-side fetches read it.
PUBLIC_API_URL=

# Cloudflare Turnstile site key for the contact form and survey.
PUBLIC_TURNSTILE_SITE_KEY=

# external tooling: read by the @clerk/astro integration.
# Clerk publishable key, for client-side sign-in. Access to notes and admin
# pages is decided by the API, not by anything in this site.
PUBLIC_CLERK_PUBLISHABLE_KEY=
