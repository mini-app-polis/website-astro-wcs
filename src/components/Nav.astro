---
import { Show, UserButton } from "@clerk/astro/components";
import {
  getAuthenticatedUserId,
  getClerkUserData,
  getSessionToken,
  upsertWcsProfile,
} from "../lib/auth";
import { getApiBase } from "../lib/api";

const { pathname } = Astro.url;
const runtime = Astro.locals.runtime;
const env = runtime?.env as Record<string, string> | undefined;
const apiBase = getApiBase(env?.KAIANO_API_BASE_URL);
const userId = await getAuthenticatedUserId(Astro.request, env);

let isAdmin = false;
try {
  const sessionToken = getSessionToken(Astro.request);
  if (userId && sessionToken && apiBase) {
    // Upsert (not just read) so the WCS profile row is guaranteed to exist on
    // the very first request after sign-in. Previously Nav called the
    // read-only getWcsProfile, which returned 404/null until some other page
    // (e.g. /notes) had a chance to create the row — making the Admin link
    // only appear after a reload.
    const { email, displayName } = await getClerkUserData(userId, env);
    const profile = await upsertWcsProfile(
      sessionToken,
      email,
      displayName,
      apiBase,
    );
    isAdmin = profile?.is_admin ?? false;
  }
} catch {
  // Nav must never crash the page — isAdmin stays false
}

type SubItem = { href: string; label: string };
type NavItem = {
  href?: string;
  label: string;
  submenu?: SubItem[];
  // When true the item is only rendered visibly for admins. It is always
  // present in the DOM so a client-side reveal can flip it on if the SSR
  // pass didn't manage to confirm admin status (e.g. stale __session JWT).
  adminOnly?: boolean;
};
type MobileLink = SubItem & { adminOnly?: boolean };

const moreSubmenu: SubItem[] = [
  { href: "/about", label: "About" },
  { href: "/notes", label: "Notes" },
];

const adminSubmenu: SubItem[] = [
  { href: "/admin/users", label: "Manage Users" },
  { href: "/admin/notes", label: "Manage Notes" },
  { href: "/notes/admin", label: "Notes Admin View" },
  { href: "/notes/ask", label: "Ask" },
];

const items: NavItem[] = [
  {
    label: "Booking",
    submenu: [
      { href: "/booking/lessons", label: "WCS Lessons" },
      { href: "/booking/press-kit", label: "Press Kit" },
    ],
  },
  {
    label: "DJ Marvel",
    submenu: [
      { href: "/sets", label: "Full History" },
      { href: "/live", label: "Recent Music" },
      { href: "/catalog", label: "Stats" },
      { href: "/spotify", label: "Spotify" },
      { href: "https://deejaytools.com/", label: "Submit Music ↗" },
    ],
  },
  { href: "/locate", label: "Locate" },
  { href: "/contact", label: "Contact" },
  {
    label: "More",
    submenu: moreSubmenu,
  },
  // Always rendered; CSS hides it for non-admins. The client-side reveal
  // script unhides it once we've confirmed admin status against the API.
  {
    label: "Admin",
    submenu: adminSubmenu,
    adminOnly: true,
  },
];

// Flatten all hrefs for the mobile drawer. Propagate the parent's adminOnly
// flag down to each leaf so the mobile drawer can also hide/reveal as a group.
const allLinks: MobileLink[] = items.flatMap((item) =>
  item.submenu
    ? item.submenu.map((sub) => ({ ...sub, adminOnly: item.adminOnly }))
    : [{ href: item.href!, label: item.label, adminOnly: item.adminOnly }],
);

// Static sub-pages that should NOT cause their parent to highlight.
// These are admin pages that live under /notes/* but belong to the Admin
// submenu, so the More > Notes parent shouldn't activate when visiting them.
const STATIC_SUBPAGES = new Set(["/notes/admin", "/notes/ask"]);

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  if (pathname === href) return true;
  // Don't highlight parent when on a static sibling sub-page
  if (STATIC_SUBPAGES.has(pathname)) return false;
  // Highlight parent for dynamic sub-routes (e.g. /sets/[id], /notes/[id])
  return pathname.startsWith(`${href}/`);
}
---

<nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
  <!-- Logo -->
  <a href="/" class="group flex items-baseline gap-3">
    <span class="font-serif italic text-lg font-bold tracking-tight text-slate-100 transition-colors group-hover:text-accent">
      Kaiano Levine
    </span>
    <span class="hidden font-mono text-xs text-slate-500 sm:inline">wcs</span>
  </a>

  <!-- Desktop links -->
  <div class="hidden items-center gap-1 text-sm md:flex">
    {items.map((item) => {
      const hiddenForAdminOnly = item.adminOnly && !isAdmin;
      if (item.submenu) {
        const anyActive = item.submenu.some((s) => isActive(s.href));
        return (
          <div
            class={`group relative ${hiddenForAdminOnly ? "hidden" : ""}`}
            data-admin-only={item.adminOnly ? "true" : undefined}
          >
            <button
              type="button"
              class={`flex items-center gap-1 rounded-full px-3 py-1.5 transition-colors ${
                anyActive ? "text-accent" : "text-slate-300 hover:text-slate-100"
              }`}
            >
              {item.label}
              <svg class="h-3 w-3 opacity-50 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none">
                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="invisible absolute right-0 top-full z-50 mt-1.5 min-w-[160px] rounded-xl border border-white/10 bg-surface/95 p-1.5 opacity-0 shadow-soft backdrop-blur transition-all group-hover:visible group-hover:opacity-100">
              {item.submenu.map((sub) => (
                <a
                  href={sub.href}
                  class={`block rounded-lg px-3 py-2 text-sm transition-colors ${
                    isActive(sub.href)
                      ? "text-accent"
                      : "text-slate-300 hover:bg-accent/10 hover:text-accent"
                  }`}
                >
                  {sub.label}
                </a>
              ))}
            </div>
          </div>
        );
      }
      const active = isActive(item.href!);
      return (
        <a
          href={item.href}
          class={`rounded-full px-3 py-1.5 transition-colors ${
            active ? "text-accent" : "text-slate-300 hover:text-slate-100"
          } ${hiddenForAdminOnly ? "hidden" : ""}`}
          data-admin-only={item.adminOnly ? "true" : undefined}
          aria-current={active ? "page" : undefined}
        >
          {item.label}
        </a>
      );
    })}
  </div>

  <div class="hidden md:flex items-center ml-4">
    <Show when="signed-out">
      <a
        href="/sign-in"
        class="font-mono text-xs uppercase tracking-widest text-slate-400 transition-colors hover:text-accent"
      >
        Sign in
      </a>
    </Show>
    <Show when="signed-in">
      <UserButton />
    </Show>
  </div>

  <!-- Mobile hamburger -->
  <button
    id="nav-open"
    type="button"
    aria-label="Open menu"
    class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 text-slate-300 transition-colors hover:border-white/20 hover:text-slate-100 md:hidden"
  >
    <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5">
      <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>
</nav>

<!-- Mobile drawer -->
<div
  id="nav-drawer"
  aria-hidden="true"
  style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:9999;transform:translateX(100%);transition:transform 300ms ease;display:flex;flex-direction:column;background:#1f1f27;"
  class="md:hidden"
>
  <div class="flex items-center justify-between border-b border-white/10 px-6 py-5">
    <a href="/" class="font-serif italic text-lg tracking-tight text-slate-100">
      Kaiano Levine
    </a>
    <button
      id="nav-close"
      type="button"
      aria-label="Close menu"
      class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 text-slate-300 transition-colors hover:border-white/20 hover:text-slate-100"
    >
      <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="flex flex-col gap-1 overflow-y-auto p-4">
    {allLinks.map((link) => {
      const hiddenForAdminOnly = link.adminOnly && !isAdmin;
      return (
        <a
          href={link.href}
          class={`rounded-xl px-4 py-3 text-sm font-medium transition-colors ${
            isActive(link.href)
              ? "bg-accent/10 text-accent"
              : "text-slate-300 hover:bg-white/5 hover:text-slate-100"
          } ${hiddenForAdminOnly ? "hidden" : ""}`}
          data-admin-only={link.adminOnly ? "true" : undefined}
        >
          {link.label}
        </a>
      );
    })}
  </nav>

  <div class="mt-4 border-t border-white/10 pt-4">
    <Show when="signed-out">
      <a href="/sign-in" class="font-mono text-xs uppercase tracking-widest text-slate-400">
        Sign in
      </a>
    </Show>
    <Show when="signed-in">
      <UserButton />
    </Show>
  </div>
</div>

<script>
  const openBtn = document.getElementById("nav-open");
  const closeBtn = document.getElementById("nav-close");
  const drawer = document.getElementById("nav-drawer");

  function openDrawer() {
    if (!drawer) return;
    drawer.style.transform = "translateX(0)";
    drawer.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.style.transform = "translateX(100%)";
    drawer.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  openBtn?.addEventListener("click", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);

  // Close on backdrop click (clicking outside the drawer content area)
  drawer?.addEventListener("click", (e) => {
    if (e.target === drawer) closeDrawer();
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDrawer();
  });
</script>

<script>
  // Client-side admin reveal.
  //
  // The SSR pass in Nav.astro tries to determine isAdmin via verifyToken +
  // the WCS API. If the user's __session JWT is stale on the first request
  // (Clerk JWTs are ~60s; the cookie often holds an expired one that the
  // client refreshes only after the page loads), SSR sees isAdmin=false
  // and renders the Admin menu items hidden.
  //
  // Once Clerk has loaded client-side it always has a fresh session, so
  // here we re-check against /v1/wcs/me using a live token and reveal
  // the admin items if the API confirms is_admin=true. This is also why
  // the items are always rendered into the DOM (with a `hidden` class)
  // rather than conditionally — we don't want a layout-shift flash, just
  // a visibility toggle.

  function revealAdminItems() {
    document
      .querySelectorAll('[data-admin-only="true"]')
      .forEach((el) => el.classList.remove("hidden"));
  }

  function hideAdminItems() {
    document
      .querySelectorAll('[data-admin-only="true"]')
      .forEach((el) => el.classList.add("hidden"));
  }

  async function waitForClerk(timeoutMs = 8000) {
    const start = Date.now();
    while (Date.now() - start < timeoutMs) {
      const C = window.Clerk;
      if (C && C.loaded) return C;
      if (C && typeof C.load === "function") {
        try {
          await C.load();
          return C;
        } catch {
          // fall through and keep polling
        }
      }
      await new Promise((r) => setTimeout(r, 50));
    }
    return null;
  }

  async function checkAdminStatus() {
    const Clerk = await waitForClerk();
    if (!Clerk) return;

    if (!Clerk.user || !Clerk.session) {
      // Signed out — make sure admin items are hidden (handles in-page sign-out)
      hideAdminItems();
      return;
    }

    const apiBase = document.documentElement.dataset.apiUrl;
    if (!apiBase) return;

    try {
      const token = await Clerk.session.getToken();
      if (!token) return;

      const base = apiBase.replace(/\/$/, "");
      const res = await fetch(base + "/v1/wcs/me", {
        headers: { Authorization: "Bearer " + token },
      });
      if (!res.ok) return; // 404 (no profile) → not admin; leave hidden

      const json = await res.json().catch(() => null);
      const isAdmin = json && json.data && json.data.is_admin === true;
      if (isAdmin) {
        revealAdminItems();
      } else {
        hideAdminItems();
      }
    } catch (err) {
      console.warn("[nav] admin-status check failed:", err);
    }
  }

  // Run once on load, and again whenever Clerk's auth state changes
  // (covers in-page sign-in / sign-out without a full reload).
  checkAdminStatus();
  waitForClerk().then((Clerk) => {
    if (Clerk && typeof Clerk.addListener === "function") {
      Clerk.addListener(() => {
        checkAdminStatus();
      });
    }
  });
</script>
