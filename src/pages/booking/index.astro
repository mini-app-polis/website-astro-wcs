---
import Page from "../../layouts/Page.astro";
---

<Page title="Booking" subtitle="Lessons and press kit">
  <div class="grid gap-4 sm:grid-cols-2">
    <a
      href="/booking/lessons"
      class="group flex flex-col gap-2 rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:border-white/20 hover:bg-white/[0.04]"
    >
      <h2 class="font-display text-xl tracking-tight transition-colors group-hover:text-accent">
        WCS Lessons
      </h2>
      <p class="text-sm leading-relaxed text-slate-400">
        Private lessons across the Twin Cities, SWINGesota, and weekend conventions.
      </p>
    </a>

    <a
      href="/booking/press-kit"
      class="group flex flex-col gap-2 rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:border-white/20 hover:bg-white/[0.04]"
    >
      <h2 class="font-display text-xl tracking-tight transition-colors group-hover:text-accent">
        Press Kit
      </h2>
      <p class="text-sm leading-relaxed text-slate-400">
        Official photos, bios, and videos — hosted on Google Drive.
      </p>
    </a>
  </div>
</Page>
