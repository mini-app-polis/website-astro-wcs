---
import Page from "../../layouts/Page.astro";

const bookingLinks = [
  {
    label: "I Come To You — Twin Cities Area",
    href: "https://kaiano-wcs-icometoyou.youcanbook.me/",
  },
  {
    label: "You Come To Me — Minneapolis",
    href: "https://kaiano-wcs-youcometome.youcanbook.me/",
  },
  {
    label: "@ SWINGesota — Wednesdays",
    href: "https://kaiano-wcs-swingesota.youcanbook.me/",
  },
  {
    label: "@ Weekend Conventions",
    href: "https://kaiano-wcs-convention.youcanbook.me/",
  },
] as const;

// Lesson info accordions — order matches render below
const lessonDocs = [
  { title: "Intro Survey" },
  { title: "Pricing" },
  { title: "Common Questions" },
  { title: "Locations" },
] as const;
---

<Page
  title="WCS Lessons"
  subtitle="Private lessons with Kaiano Levine"
>
  <div class="space-y-10">
    <!-- Booking links -->
    <section class="space-y-4">
      <div>
        <h2 class="font-serif text-xl font-black italic tracking-tight" style="font-variation-settings: 'opsz' 72;">Book a Lesson</h2>
        <p class="mt-1 text-sm text-slate-400">
          Questions not answered below?
          <a href="/contact" class="text-accent transition-colors hover:text-accent/80">
            Contact →
          </a>
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        {bookingLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] px-5 py-4 text-sm font-medium transition-colors hover:border-white/20 hover:bg-white/[0.04] hover:text-accent"
          >
            {link.label}
            <span class="ml-3 font-mono text-slate-500">↗</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Lesson information accordions -->
    <section class="space-y-3" data-accordion-group>
      <h2 class="font-serif text-xl font-black italic tracking-tight" style="font-variation-settings: 'opsz' 72;">Lesson Information</h2>

      {lessonDocs.map((doc) => (
        <div
          class="overflow-hidden rounded-xl border border-white/10"
          data-accordion
        >
          <button
            type="button"
            data-accordion-trigger
            aria-expanded="false"
            class="flex w-full items-center justify-between bg-white/[0.02] px-5 py-4 text-left text-sm font-medium transition-colors hover:bg-white/[0.04]"
          >
            {doc.title}
            <svg
              data-accordion-icon
              class="h-4 w-4 shrink-0 text-slate-400 transition-transform"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div
            data-accordion-body
            class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-200"
          >
            <div class="overflow-hidden">
              <div class="border-t border-white/10 px-5 py-4">
                {doc.title === "Intro Survey" ? (
                  <>
                    <p class="text-sm text-slate-400 font-light leading-relaxed">
                      If this is the first time working with Kaiano (or if it has been some time since the last time)
                      please fill out the survey at your earliest convenience. This helps us use the lesson time as
                      efficiently as possible. Feel free to read through and take some time before answering —
                      ideally before the lesson.
                    </p>
                    <a
                      href="/survey"
                      class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 font-mono text-xs font-medium uppercase tracking-widest text-canvas transition-opacity hover:opacity-90"
                    >
                      Student Survey →
                    </a>
                  </>
                ) : doc.title === "Pricing" ? (
                  <>
                    <p class="text-sm text-slate-400 font-light leading-relaxed">Lessons are 50 minutes by default.</p>
                    <div class="mt-2 space-y-1">
                      <p class="text-sm text-slate-300">Regular rate: <span class="text-accent font-mono">$70 USD</span></p>
                      <p class="text-sm text-slate-300">Discounted rate: <span class="text-accent font-mono">$50 USD</span></p>
                    </div>
                    <p class="mt-3 text-sm text-slate-400 font-light leading-relaxed">
                      All bookings are made through the booking portal, which requires a credit card payment entry.
                      To pay in cash instead, use code <span class="font-mono text-slate-300">PAYINCASH</span> at booking — payment is due at the start of the lesson.
                    </p>
                    <p class="mt-2 text-sm text-slate-400 font-light leading-relaxed">
                      A discounted rate is available for students and those on a fixed or limited income.
                      Use code <span class="font-mono text-slate-300">DISCOUNTRATE</span> at booking.
                    </p>
                  </>
                ) : doc.title === "Locations" ? (
                  <ul class="space-y-2 text-sm text-slate-400 font-light leading-relaxed">
                    <li><span class="text-slate-300">Weekend dance conventions</span> — variable time and availability, typical rates apply</li>
                    <li><span class="text-slate-300">SWINGesota, MN</span> — Wednesdays 6pm–10pm, typical rates apply</li>
                    <li><span class="text-slate-300">I come to you</span> — Twin Cities area, typical rates + $10</li>
                    <li><span class="text-slate-300">You come to me</span> — Minneapolis, MN, variable availability, typical rates apply</li>
                  </ul>
                ) : doc.title === "Common Questions" ? (
                  <div class="space-y-4 text-sm">
                    <div>
                      <p class="text-slate-300 font-medium">Do I need to bring a partner?</p>
                      <p class="text-slate-400 font-light leading-relaxed mt-1">A partner is not required but highly encouraged to get the most out of the lesson time.</p>
                    </div>
                    <div>
                      <p class="text-slate-300 font-medium">Can I split a private lesson with a partner?</p>
                      <p class="text-slate-400 font-light leading-relaxed mt-1">You are welcome to split lessons with as many people as you would like. This includes the same rate for small group private lessons.</p>
                    </div>
                  </div>
                ) : null}
              </div>
            </div>
          </div>
        </div>
      ))}
    </section>
  </div>

  <script>
    document.querySelectorAll("[data-accordion]").forEach((el) => {
      const trigger = el.querySelector("[data-accordion-trigger]") as HTMLButtonElement | null;
      const body = el.querySelector("[data-accordion-body]") as HTMLElement | null;
      const icon = el.querySelector("[data-accordion-icon]") as HTMLElement | null;
      if (!trigger || !body) return;

      trigger.addEventListener("click", () => {
        const expanded = trigger.getAttribute("aria-expanded") === "true";
        trigger.setAttribute("aria-expanded", String(!expanded));
        body.style.gridTemplateRows = expanded ? "0fr" : "1fr";
        icon?.style.setProperty("transform", expanded ? "" : "rotate(180deg)");
      });
    });
  </script>
</Page>
