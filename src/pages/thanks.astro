---
import Page from "../layouts/Page.astro";
---

<Page title="Thanks!" subtitle="Your message has been sent.">
  <div class="flex min-h-[200px] items-center justify-center rounded-2xl border border-white/10 bg-white/[0.02]">
    <div class="text-center space-y-2">
      <p class="font-display text-2xl tracking-tight text-accent">Message sent!</p>
      <p class="text-sm text-slate-400">Kaiano will get back to you soon.</p>
      <a href="/" class="inline-block mt-4 font-mono text-sm text-slate-400 hover:text-accent transition-colors">← Home</a>
    </div>
  </div>
</Page>
