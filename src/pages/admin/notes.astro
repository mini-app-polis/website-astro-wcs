---
import Page from "../../layouts/Page.astro";
import {
  getAuthenticatedUserId,
  getClerkUserData,
  getSessionToken,
  upsertWcsProfile,
} from "../../lib/auth";
import { getApiBase } from "../../lib/api";

const runtime = Astro.locals.runtime;
const env = runtime?.env as Record<string, string> | undefined;
const apiBase = getApiBase(env?.KAIANO_API_BASE_URL);

const userId = await getAuthenticatedUserId(Astro.request, env);
const sessionToken = getSessionToken(Astro.request);

if (!userId || !sessionToken) {
  return Astro.redirect("/sign-in");
}

const clerkUserData = await getClerkUserData(userId, env);
const profile = apiBase
  ? await upsertWcsProfile(sessionToken, clerkUserData.email, clerkUserData.displayName, apiBase)
  : null;

if (!profile?.is_admin) {
  return Astro.redirect("/");
}
---

<Page title="Manage Notes" subtitle="Default note visibility">
  <div
    class="space-y-4"
    data-admin-notes
    data-api-base={apiBase}
    data-session-token={sessionToken}
  >
    <p class="text-xs font-mono text-slate-500">Toggle which notes are visible to all signed-in users.</p>
    <div id="notes-loading" class="text-sm text-slate-500">Loading…</div>
    <div id="notes-error" class="text-sm text-slate-500 hidden">Could not load notes.</div>
    <div id="notes-list" class="hidden space-y-2"></div>
  </div>
</Page>

<script type="module">
  const root = document.querySelector("[data-admin-notes]");
  const API_BASE = root?.dataset.apiBase ?? "";
  const SESSION_TOKEN = root?.dataset.sessionToken ?? "";
  const H = SESSION_TOKEN
    ? { Authorization: `Bearer ${SESSION_TOKEN}`, "Content-Type": "application/json" }
    : { "Content-Type": "application/json" };

  const show = (el) => el?.classList.remove("hidden");
  const hide = (el) => el?.classList.add("hidden");
  const base = API_BASE.replace(/\/$/, "");
  const SESSION_LABELS = {
    private_lesson: "Private lesson",
    group_class: "Group class",
    other: "Other",
  };

  function sourceLabel(source) {
    const parts = [];
    if (source.session_date) parts.push(source.session_date);
    if (source.session_type) parts.push(SESSION_LABELS[source.session_type] || source.session_type);
    if (source.session_type === "private_lesson") {
      if (source.students_raw?.length) parts.push(source.students_raw.join(" + "));
    } else {
      if (source.organization) parts.push(source.organization);
    }
    if (source.instructors_raw?.length) parts.push("w/ " + source.instructors_raw.join(" + "));
    if (source.title) parts.push(source.title);
    return parts.join(" · ") || source.id;
  }

  async function loadNotes() {
    const loadEl = document.getElementById("notes-loading");
    const errEl = document.getElementById("notes-error");
    const listEl = document.getElementById("notes-list");
    try {
      const PAGE = 100;
      let offset = 0;
      const sources = [];
      while (true) {
        const params = new URLSearchParams({ limit: String(PAGE), offset: String(offset) });
        const res = await fetch(`${base}/v1/wcs/wiki/admin/sources?${params}`, { headers: H });
        if (!res.ok) throw new Error("bad response");
        const json = await res.json();
        const page = json.data ?? [];
        sources.push(...page);
        if (page.length < PAGE) break;
        offset += PAGE;
      }
      hide(loadEl);
      renderNotes(listEl, sources);
      show(listEl);
    } catch {
      hide(loadEl);
      show(errEl);
    }
  }

  function renderNotes(listEl, sources) {
    listEl.innerHTML = "";
    if (sources.length === 0) {
      listEl.innerHTML = `<p class="text-sm text-slate-500">No lessons found.</p>`;
      return;
    }
    for (const source of sources) {
      const row = document.createElement("div");
      row.className = "flex items-center justify-between gap-4 rounded-xl border border-white/8 bg-surface/60 px-4 py-3";

      const left = document.createElement("div");
      left.className = "min-w-0 flex items-center gap-3";

      const visibleBadge = document.createElement("span");
      visibleBadge.className = `inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-mono shrink-0 ${
        source.is_default_visible
          ? "bg-teal-500/10 text-teal-300 border-teal-500/25"
          : "bg-slate-500/10 text-slate-400 border-slate-500/25"
      }`;
      visibleBadge.textContent = source.is_default_visible ? "visible" : "hidden";

      const title = document.createElement("span");
      title.className = "text-sm text-slate-200 truncate";
      title.textContent = sourceLabel(source);

      left.append(visibleBadge, title);

      const actions = document.createElement("div");
      actions.className = "flex items-center gap-3 shrink-0";

      const editLink = document.createElement("a");
      editLink.href = `/admin/notes/${source.id}`;
      editLink.className = "text-xs font-mono text-slate-400 hover:text-accent transition-colors";
      editLink.textContent = "Edit";

      const toggleBtn = document.createElement("button");
      toggleBtn.type = "button";
      toggleBtn.className = "text-xs font-mono text-slate-400 hover:text-accent transition-colors";
      toggleBtn.textContent = source.is_default_visible ? "Hide" : "Show";

      toggleBtn.addEventListener("click", async () => {
        toggleBtn.disabled = true;
        const newVal = !source.is_default_visible;
        const res = await fetch(`${base}/v1/wcs/admin/sources/${source.id}/visibility`, {
          method: "PATCH",
          headers: H,
          body: JSON.stringify({ is_default_visible: newVal }),
        });
        if (res.ok) {
          const updated = (await res.json().catch(() => ({})))?.data;
          const visible = updated?.is_default_visible ?? newVal;
          source.is_default_visible = visible;
          visibleBadge.textContent = visible ? "visible" : "hidden";
          visibleBadge.className = `inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-mono shrink-0 ${
            visible
              ? "bg-teal-500/10 text-teal-300 border-teal-500/25"
              : "bg-slate-500/10 text-slate-400 border-slate-500/25"
          }`;
          toggleBtn.textContent = visible ? "Hide" : "Show";
        }
        toggleBtn.disabled = false;
      });

      actions.append(editLink, toggleBtn);
      row.append(left, actions);
      listEl.appendChild(row);
    }
  }

  loadNotes();
</script>
