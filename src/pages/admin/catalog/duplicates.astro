---
import Page from "../../../layouts/Page.astro";
import CatalogDuplicates from "../../../components/CatalogDuplicates";
import { getApiBase } from "../../../lib/api";

// The owner's duplicates page. No gate here, by design: authorization is the
// API's decision (catalog.tracks.write), made once at the enforcement point
// and audited there. The page asks the API for the groups, and a refusal is
// what a visitor without the scope sees. See docs/STATIC-AUTH-OFFLOAD.md.
const apiBase = getApiBase();
---

<Page title="Duplicates" subtitle="Copies of one song in the music library">
  <p class="mb-6 text-sm text-slate-400">
    The nightly run groups library files on one song. Decide each file: keep it on the entry
    (several files, such as Clean and Explicit, can share one), give it a version entry of its
    own, or send it to Drive's trash (recoverable for 30 days) on the next nightly run. A group
    whose files all stay is kept together and not shown again unless its files change. A
    different edit defaults to its own version; trashing one takes a separate confirmation.
  </p>
  <CatalogDuplicates client:load apiBase={apiBase ?? ""} />
</Page>
