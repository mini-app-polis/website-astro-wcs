---
import Page from "../../layouts/Page.astro";
import WikiIndex from "../../components/WikiIndex";
import WikiOperations from "../../components/WikiOperations";
import WikiReview from "../../components/WikiReview";
import { getApiBase } from "../../lib/api";

// Every wiki page, private evidence included, from the admin routes. No gate
// here: the API refuses a caller without wcs.corpus.read and WikiIndex routes
// that refusal. ?as=public lists only the pages a reader with no grants sees.
// Review (MINI-101): fold decisions, thin entities, and what each source
// changed.
const apiBase = getApiBase();
---

<Page title="Wiki (Admin)" subtitle="Every page, private evidence included">
  <div class="mb-8">
    <WikiOperations client:load apiBase={apiBase ?? ""} scope="wiki" />
  </div>
  <div class="mb-8">
    <WikiReview client:load apiBase={apiBase ?? ""} />
  </div>
  <WikiIndex client:load apiBase={apiBase ?? ""} mode="admin" />
</Page>
