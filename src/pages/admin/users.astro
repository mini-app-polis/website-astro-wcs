---
import Page from "../../layouts/Page.astro";
import { getApiBase } from "../../lib/api";

// Static. No gate here, by design: authorization is the API's decision,
// made once at the enforcement point and audited there. This page renders,
// calls, and follows the answer. See docs/STATIC-AUTH-OFFLOAD.md.
const apiBase = getApiBase();
---

<Page title="Manage Users" subtitle="WCS access management">
  <div
    class="space-y-4"
    data-admin-users
    data-api-base={apiBase}
  >
    <p class="text-xs font-mono text-slate-500">Signed-in users and their WCS access level.</p>
    <div id="users-loading" class="text-sm text-slate-500">Loading…</div>
    <div id="users-error" class="text-sm text-slate-500 hidden">Could not load users.</div>
    <div id="users-list" class="hidden space-y-2"></div>
  </div>
</Page>

<script type="module">
  import { requireSession, guardedFetch } from "../../lib/session";
  const root = document.querySelector("[data-admin-users]");
  const API_BASE = root?.dataset.apiBase ?? "";
  const SESSION_TOKEN = await requireSession(API_BASE);
  const H = SESSION_TOKEN
    ? { Authorization: `Bearer ${SESSION_TOKEN}`, "Content-Type": "application/json" }
    : { "Content-Type": "application/json" };

  const show = (el) => el?.classList.remove("hidden");
  const hide = (el) => el?.classList.add("hidden");
  const base = API_BASE.replace(/\/$/, "");
  const SESSION_LABELS = {
    private_lesson: "Private lesson",
    group_class: "Group class",
    other: "Other",
  };

  function noteLabel(note) {
    const parts = [];
    if (note.session_date) parts.push(note.session_date);
    if (note.session_type) parts.push(SESSION_LABELS[note.session_type] || note.session_type);
    if (note.session_type === "private_lesson") {
      if (note.students?.length) parts.push(note.students.join(" + "));
    } else {
      if (note.organization) parts.push(note.organization);
    }
    if (note.instructors?.length) parts.push("w/ " + note.instructors.join(" + "));
    if (note.title) parts.push(note.title);
    return parts.join(" · ") || note.id;
  }

  function pill(text, color = "slate") {
    const s = document.createElement("span");
    s.className = `inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-mono bg-${color}-500/10 text-${color}-300 border-${color}-500/25`;
    s.textContent = text;
    return s;
  }

  let allUsers = [];
  let grantsPanel = null;

  async function loadUsers() {
    const loadEl = document.getElementById("users-loading");
    const errEl = document.getElementById("users-error");
    const listEl = document.getElementById("users-list");
    try {
      const res = await guardedFetch(`${base}/v1/wcs/admin/users`, { headers: H });
      if (!res.ok) throw new Error("bad response");
      const json = await res.json();
      allUsers = json.data ?? [];
      hide(loadEl);
      renderUsers(listEl);
      show(listEl);
    } catch {
      hide(loadEl);
      show(errEl);
    }
  }

  function renderUsers(listEl) {
    listEl.innerHTML = "";
    if (allUsers.length === 0) {
      listEl.innerHTML = `<p class="text-sm text-slate-500">No users yet.</p>`;
      return;
    }
    for (const user of allUsers) {
      const row = document.createElement("div");
      row.className = "flex items-center justify-between gap-4 rounded-xl border border-white/8 bg-surface/60 px-4 py-3";

      const left = document.createElement("div");
      left.className = "min-w-0";
      const name = document.createElement("p");
      name.className = "text-sm font-medium text-slate-100 truncate";
      name.textContent = user.display_name || user.email || user.user_id;
      const email = document.createElement("p");
      email.className = "text-xs text-slate-500 truncate font-mono";
      email.textContent = user.email || user.user_id;
      left.append(name, email);

      const right = document.createElement("div");
      right.className = "flex items-center gap-3 shrink-0";

      if (user.is_admin) right.appendChild(pill("admin", "violet"));

      const adminBtn = document.createElement("button");
      adminBtn.type = "button";
      adminBtn.className = "text-xs font-mono text-slate-400 hover:text-slate-100 transition-colors";
      adminBtn.textContent = user.is_admin ? "Revoke admin" : "Make admin";
      adminBtn.addEventListener("click", async () => {
        adminBtn.disabled = true;
        const res = await guardedFetch(`${base}/v1/wcs/admin/users/${user.user_id}`, {
          method: "PATCH",
          headers: H,
          body: JSON.stringify({ is_admin: !user.is_admin }),
        });
        if (!res.ok) {
          // Do not move the UI on a failed write. A 404 or 422 used to flip the
          // pill anyway, so the row claimed a role change that never happened.
          adminBtn.textContent = "Failed — retry";
          adminBtn.disabled = false;
          return;
        }
        allUsers = allUsers.map((u) =>
          u.user_id === user.user_id ? { ...u, is_admin: !u.is_admin } : u,
        );
        renderUsers(listEl);
      });

      const grantsBtn = document.createElement("button");
      grantsBtn.type = "button";
      grantsBtn.className = "text-xs font-mono text-slate-400 hover:text-accent transition-colors";
      grantsBtn.textContent = "Manage grants →";
      grantsBtn.addEventListener("click", () => openGrantsPanel(user));

      right.append(adminBtn, grantsBtn);
      row.append(left, right);
      listEl.appendChild(row);
    }
  }

  async function openGrantsPanel(user) {
    grantsPanel?.remove();
    grantsPanel = null;

    const listEl = document.getElementById("users-list");
    const panel = document.createElement("div");
    panel.className = "rounded-xl border border-accent/20 bg-surface/80 p-5 space-y-4";
    grantsPanel = panel;

    const header = document.createElement("div");
    header.className = "flex items-center justify-between";
    const title = document.createElement("p");
    title.className = "text-sm font-medium text-slate-100";
    title.textContent = `Grants — ${user.display_name || user.email}`;
    const closeBtn = document.createElement("button");
    closeBtn.type = "button";
    closeBtn.className = "text-xs text-slate-500 hover:text-slate-100";
    closeBtn.textContent = "Close";
    closeBtn.addEventListener("click", () => {
      panel.remove();
      grantsPanel = null;
    });
    header.append(title, closeBtn);
    panel.appendChild(header);

    const grantsList = document.createElement("div");
    grantsList.className = "space-y-2";
    grantsList.textContent = "Loading grants…";
    panel.appendChild(grantsList);

    listEl.appendChild(panel);

    // guardedFetch, not fetch: these were the only two calls on the site still
    // using raw fetch, so a 401 here degraded to "No notes found." instead of
    // sending the admin to sign in. And the whole block is wrapped, because an
    // unhandled rejection used to leave "Loading grants…" on screen forever —
    // a gateway error page makes .json() throw.
    let grants = [];
    let notes = [];
    try {
      const grantsRes = await guardedFetch(
        `${base}/v1/wcs/admin/grants?user_id=${user.user_id}`,
        { headers: H },
      );
      if (!grantsRes.ok) throw new Error("grants");
      grants = (await grantsRes.json()).data ?? [];

      // /v1/wcs/notes/all caps limit at 100. A single call silently made every
      // note past the hundredth ungrantable, with nothing on screen to say so.
      const PAGE = 100;
      for (let offset = 0; ; offset += PAGE) {
        const res = await guardedFetch(
          `${base}/v1/wcs/notes/all?limit=${PAGE}&offset=${offset}`,
          { headers: H },
        );
        if (!res.ok) throw new Error("notes");
        const page = (await res.json()).data;
        if (!Array.isArray(page) || page.length === 0) break;
        notes.push(...page);
        if (page.length < PAGE) break;
      }
    } catch {
      grantsList.textContent = "Could not load grants.";
      return;
    }

    grantsList.innerHTML = "";

    if (notes.length === 0) {
      grantsList.textContent = "No notes found.";
      return;
    }

    const grantedIds = new Set(grants.map((g) => g.note_id));

    for (const note of notes) {
      const noteRow = document.createElement("div");
      noteRow.className = "flex items-center justify-between gap-3 rounded-lg border border-white/6 bg-white/[0.02] px-3 py-2";

      const noteTitle = document.createElement("span");
      noteTitle.className = "text-xs text-slate-300 truncate min-w-0";
      noteTitle.textContent = noteLabel(note);

      const hasGrant = grantedIds.has(note.id);
      const grantObj = grants.find((g) => g.note_id === note.id);

      const toggleBtn = document.createElement("button");
      toggleBtn.type = "button";
      toggleBtn.className = `text-xs font-mono shrink-0 transition-colors ${hasGrant ? "text-accent hover:text-red-400" : "text-slate-500 hover:text-accent"}`;
      toggleBtn.textContent = hasGrant ? "Revoke" : "Grant";
      toggleBtn.addEventListener("click", async () => {
        toggleBtn.disabled = true;
        if (hasGrant && grantObj) {
          const del = await guardedFetch(`${base}/v1/wcs/admin/grants/${grantObj.id}`, { method: "DELETE", headers: H });
          if (!del.ok) { toggleBtn.textContent = "Failed"; toggleBtn.disabled = false; return; }
          grantedIds.delete(note.id);
          toggleBtn.textContent = "Grant";
          toggleBtn.className = "text-xs font-mono shrink-0 transition-colors text-slate-500 hover:text-accent";
        } else {
          const res = await guardedFetch(`${base}/v1/wcs/admin/grants`, {
            method: "POST",
            headers: H,
            body: JSON.stringify({ user_id: user.user_id, note_id: note.id }),
          });
          // POST returns 409 on a duplicate. Without this check .data is
          // undefined, undefined lands in grants[], and the button claims a
          // grant that was never created.
          if (!res.ok) { toggleBtn.textContent = "Failed"; toggleBtn.disabled = false; return; }
          const newGrant = (await res.json()).data;
          if (!newGrant) { toggleBtn.textContent = "Failed"; toggleBtn.disabled = false; return; }
          grantedIds.add(note.id);
          grants.push(newGrant);
          toggleBtn.textContent = "Revoke";
          toggleBtn.className = "text-xs font-mono shrink-0 transition-colors text-accent hover:text-red-400";
        }
        toggleBtn.disabled = false;
      });

      noteRow.append(noteTitle, toggleBtn);
      grantsList.appendChild(noteRow);
    }
  }

  loadUsers();
</script>
