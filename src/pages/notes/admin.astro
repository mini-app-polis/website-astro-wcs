---
import Page from "../../layouts/Page.astro";
import { getApiBase } from "../../lib/api";

// Static. No gate here, by design: authorization is the API's decision,
// made once at the enforcement point and audited there. This page renders,
// calls, and follows the answer. See docs/STATIC-AUTH-OFFLOAD.md.
const apiBase = getApiBase();
---

<Page title="Lessons (Admin)" subtitle="All lessons and corrections">
  <div
    class="contents"
    data-notes-browser
  >
    <div class="mb-6">
      <a href="/notes" class="text-xs text-slate-500 hover:text-slate-300 transition-colors">
        ← Lessons
      </a>
    </div>

    <p class="text-xs font-mono text-slate-500 mb-6">
      <span class="text-teal-400">●</span> visible to signed-in users &nbsp;
      <span class="text-slate-600">●</span> hidden
    </p>

    <div id="notes-loading" class="text-sm text-slate-500">Loading…</div>
    <div id="notes-error" class="text-sm text-slate-500 hidden">Could not load lessons.</div>

    <!-- Filters -->
    <div id="notes-filters" class="hidden space-y-4 mb-8">
      <div class="flex items-center gap-3">
        <span class="text-xs font-mono text-slate-500 shrink-0">Search</span>
        <input
          id="notes-search"
          type="text"
          placeholder="Title, organization, student…"
          class="w-full max-w-sm rounded-full border border-white/10 bg-white/[0.02] px-4 py-1.5 text-xs font-mono text-slate-200 placeholder:text-slate-600 outline-none focus:border-accent/50 transition-colors"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-slate-500 shrink-0">Type</span>
        <div class="flex flex-wrap items-center gap-2" data-type-buttons>
          <button type="button" data-type="" data-selected="true" aria-pressed="true"
            class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 text-xs font-mono transition-colors hover:border-white/20 hover:text-slate-100 data-[selected=true]:border-accent data-[selected=true]:bg-accent/15 data-[selected=true]:text-accent">
            All
          </button>
          <button type="button" data-type="private_lesson" data-selected="false" aria-pressed="false"
            class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 text-xs font-mono transition-colors hover:border-white/20 hover:text-slate-100 data-[selected=true]:border-accent data-[selected=true]:bg-accent/15 data-[selected=true]:text-accent">
            Private lesson
          </button>
          <button type="button" data-type="group_class" data-selected="false" aria-pressed="false"
            class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 text-xs font-mono transition-colors hover:border-white/20 hover:text-slate-100 data-[selected=true]:border-accent data-[selected=true]:bg-accent/15 data-[selected=true]:text-accent">
            Group class
          </button>
          <button type="button" data-type="correction" data-selected="false" aria-pressed="false"
            class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 text-xs font-mono transition-colors hover:border-white/20 hover:text-slate-100 data-[selected=true]:border-accent data-[selected=true]:bg-accent/15 data-[selected=true]:text-accent">
            Correction
          </button>
        </div>
      </div>

      <div id="notes-org-row" class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-slate-500 shrink-0">With</span>
        <div class="flex flex-wrap items-center gap-2" data-org-buttons>
          <button type="button" data-org="" data-selected="true" aria-pressed="true"
            class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 text-xs font-mono transition-colors hover:border-white/20 hover:text-slate-100 data-[selected=true]:border-accent data-[selected=true]:bg-accent/15 data-[selected=true]:text-accent">
            All
          </button>
        </div>
      </div>

      <div id="notes-instructor-row" class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-slate-500 shrink-0">Instructor</span>
        <div class="flex flex-wrap items-center gap-2" data-instructor-buttons>
          <button type="button" data-instructor="" data-selected="true" aria-pressed="true"
            class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 text-xs font-mono transition-colors hover:border-white/20 hover:text-slate-100 data-[selected=true]:border-accent data-[selected=true]:bg-accent/15 data-[selected=true]:text-accent">
            All
          </button>
        </div>
      </div>
    </div>

    <p id="notes-count" class="hidden text-xs font-mono text-slate-500 mb-5"></p>
    <p id="notes-empty" class="hidden text-sm text-slate-500">No lessons match the filters.</p>
    <div id="notes-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>

    <script type="module">
  import { requireSession, guardedFetch } from "../../lib/session";
      const BASE      = document.documentElement.dataset.apiUrl || "";
      const SESSION_TOKEN = await requireSession(BASE);
      const loadingEl = document.getElementById("notes-loading");
      const errorEl   = document.getElementById("notes-error");
      const emptyEl   = document.getElementById("notes-empty");
      const gridEl    = document.getElementById("notes-grid");
      const filtersEl = document.getElementById("notes-filters");
      const countEl   = document.getElementById("notes-count");
      const searchEl  = document.getElementById("notes-search");
      const orgRow    = document.getElementById("notes-org-row");

      const SESSION_LABELS = {
        private_lesson: "Private lesson",
        group_class:    "Group class",
        correction:     "Correction",
        workshop:       "Workshop",
        other:          "Other",
      };

      const TYPE_BADGE = {
        private_lesson: "bg-violet-500/10 text-violet-300 border-violet-500/25",
        group_class:    "bg-sky-500/10 text-sky-300 border-sky-500/25",
        correction:     "bg-emerald-500/10 text-emerald-300 border-emerald-500/25",
        workshop:       "bg-amber-500/10 text-amber-300 border-amber-500/25",
        other:          "bg-slate-500/10 text-slate-400 border-slate-500/25",
      };

      let allSources        = [];
      let selectedType      = "";
      let selectedOrg       = "";
      let selectedInstructor = "";
      let searchQuery        = "";

      const show = el => el.classList.remove("hidden");
      const hide = el => el.classList.add("hidden");

      function sourceInstructors(source) {
        return source.instructors_raw?.length ? source.instructors_raw.join(" + ") : "";
      }

      function sourceWith(source) {
        if (source.session_type === "private_lesson")
          return source.students_raw?.length ? source.students_raw.join(" + ") : "";
        return source.organization || "";
      }

      function formatDate(iso) {
        if (!iso) return "";
        const [y, m, d] = iso.split("-").map(Number);
        return new Date(y, m - 1, d).toLocaleDateString("en-US", {
          month: "short", day: "numeric", year: "numeric",
        });
      }

      function matchesSearch(source, q) {
        if (!q) return true;
        const haystack = [
          source.title,
          source.organization,
          ...(source.students_raw || []),
          ...(source.instructors_raw || []),
          SESSION_LABELS[source.session_type] || source.session_type,
        ].join(" ").toLowerCase();
        return haystack.includes(q.toLowerCase());
      }

      function filterSources(sources) {
        return sources.filter(source => {
          if (selectedType && source.session_type !== selectedType) return false;
          if (selectedOrg  && sourceWith(source) !== selectedOrg)     return false;
          if (selectedInstructor && !sourceInstructors(source).split(" + ").includes(selectedInstructor)) return false;
          if (!matchesSearch(source, searchQuery))                    return false;
          return true;
        });
      }

      const BTN_CLASS =
        "rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 text-xs font-mono transition-colors hover:border-white/20 hover:text-slate-100 data-[selected=true]:border-accent data-[selected=true]:bg-accent/15 data-[selected=true]:text-accent";

      function setButtonGroup(container, attr, value) {
        container.querySelectorAll(`button[${attr}]`).forEach(btn => {
          const sel = (btn.getAttribute(attr) ?? "") === value;
          btn.setAttribute("data-selected", sel ? "true" : "false");
          btn.setAttribute("aria-pressed",  sel ? "true" : "false");
        });
      }

      function buildOrgButtons(sources) {
        const wrap = document.querySelector("[data-org-buttons]");
        if (!wrap) return;
        const orgs = [...new Set(sources.map(sourceWith).filter(Boolean))].sort();
        wrap.querySelectorAll("button[data-org]:not([data-org=''])").forEach(b => b.remove());
        for (const org of orgs) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.setAttribute("data-org", org);
          btn.setAttribute("data-selected", "false");
          btn.setAttribute("aria-pressed", "false");
          btn.className = BTN_CLASS;
          btn.textContent = org;
          wrap.appendChild(btn);
        }
        orgs.length ? show(orgRow) : hide(orgRow);
      }

      function buildInstructorButtons(sources) {
        const wrap = document.querySelector("[data-instructor-buttons]");
        const row  = document.getElementById("notes-instructor-row");
        if (!wrap || !row) return;
        const instructors = [...new Set(
          sources.flatMap(s => s.instructors_raw || []).filter(Boolean)
        )].sort();
        wrap.querySelectorAll("button[data-instructor]:not([data-instructor=''])").forEach(b => b.remove());
        for (const instr of instructors) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.setAttribute("data-instructor", instr);
          btn.setAttribute("data-selected", "false");
          btn.setAttribute("aria-pressed", "false");
          btn.className = BTN_CLASS;
          btn.textContent = instr;
          wrap.appendChild(btn);
        }
        instructors.length ? show(row) : hide(row);
      }

      function buildCard(source) {
        const withVal     = sourceWith(source);
        const typeLabel   = SESSION_LABELS[source.session_type] || source.session_type;
        const badgeCls    = TYPE_BADGE[source.session_type] || TYPE_BADGE.other;
        const instructors = sourceInstructors(source);

        const a = document.createElement("a");
        a.href = `/notes/admin/detail?id=${encodeURIComponent(source.id)}`;
        a.className =
          "group flex flex-col gap-3 rounded-xl border border-white/8 bg-surface/60 p-5 " +
          "transition-colors hover:border-accent/25 hover:bg-surface";
        a.style.position = "relative";

        const visDot = document.createElement("span");
        visDot.className = source.is_default_visible
          ? "absolute top-3 right-3 h-1.5 w-1.5 rounded-full bg-teal-400"
          : "absolute top-3 right-3 h-1.5 w-1.5 rounded-full bg-slate-600";
        visDot.title = source.is_default_visible ? "Visible to signed-in users" : "Hidden";
        a.appendChild(visDot);

        const topRow = document.createElement("div");
        topRow.className = "flex items-center justify-between gap-2";

        const dateEl = document.createElement("span");
        dateEl.className = "font-mono text-xs text-slate-200 font-medium";
        dateEl.textContent = formatDate(source.session_date);

        const badge = document.createElement("span");
        badge.className =
          `inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-mono ${badgeCls}`;
        badge.textContent = typeLabel;

        topRow.appendChild(dateEl);
        topRow.appendChild(badge);
        a.appendChild(topRow);

        if (source.session_type === "correction") {
          const titleEl = document.createElement("p");
          titleEl.className = "text-sm font-medium text-slate-100 leading-snug";
          titleEl.textContent = source.title?.trim() || "Untitled correction";
          a.appendChild(titleEl);
          return a;
        }

        if (withVal) {
          const primaryEl = document.createElement("p");
          primaryEl.className = "text-sm font-medium text-slate-100 leading-snug";

          const primaryName = document.createElement("span");
          primaryName.textContent = withVal;
          primaryEl.appendChild(primaryName);

          if (instructors) {
            const withSpan = document.createElement("span");
            withSpan.className = "font-normal text-slate-500";
            withSpan.textContent = " [with " + instructors + "]";
            primaryEl.appendChild(withSpan);
          }

          a.appendChild(primaryEl);
        } else if (instructors) {
          const instrEl = document.createElement("p");
          instrEl.className = "text-sm font-medium text-slate-100 leading-snug";
          instrEl.textContent = instructors;
          a.appendChild(instrEl);
        }

        const titleEl = document.createElement("p");
        const hasPrimary = !!withVal;
        titleEl.className = hasPrimary
          ? "text-sm text-slate-400 leading-snug overflow-hidden"
          : "text-sm font-medium text-slate-100 leading-snug overflow-hidden";
        titleEl.style.cssText =
          "display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; " +
          "overflow: hidden; min-height: calc(1.25em * 2 * 1.375);";
        titleEl.textContent = source.title?.trim() || "";
        a.appendChild(titleEl);

        return a;
      }

      function render() {
        const filtered = filterSources(allSources);

        const nCorr = allSources.filter(s => s.session_type === "correction").length;
        const nLess = allSources.length - nCorr;
        countEl.textContent = filtered.length === allSources.length
          ? `${nLess} lesson${nLess !== 1 ? "s" : ""}` +
            (nCorr ? ` · ${nCorr} correction${nCorr !== 1 ? "s" : ""}` : "")
          : `${filtered.length} of ${allSources.length}`;
        show(countEl);

        gridEl.innerHTML = "";

        if (filtered.length === 0) {
          show(emptyEl); hide(gridEl); return;
        }

        hide(emptyEl);
        for (const source of filtered) gridEl.appendChild(buildCard(source));
        show(gridEl);
      }

      async function load() {
        if (!BASE) { hide(loadingEl); show(errorEl); return; }
        try {
          const base = BASE.replace(/\/$/, "");
          const PAGE = 100;
          let offset = 0;
          while (true) {
            const params = new URLSearchParams({ limit: String(PAGE), offset: String(offset) });
            const res = await guardedFetch(`${base}/v1/wcs/wiki/admin/sources?${params}`, {
              headers: SESSION_TOKEN
                ? { Authorization: `Bearer ${SESSION_TOKEN}` }
                : {},
            });
            if (!res.ok) throw new Error("bad response");
            const json = await res.json();
            const page = json.data;
        if (!Array.isArray(page)) break;
            allSources.push(...page);
            if (page.length < PAGE) break;
            offset += PAGE;
          }
          hide(loadingEl);
          buildOrgButtons(allSources);
          buildInstructorButtons(allSources);
          show(filtersEl);
          render();
        } catch {
          hide(loadingEl);
          show(errorEl);
        }
      }

      document.querySelector("[data-type-buttons]")?.addEventListener("click", e => {
        if (e.target.tagName !== "BUTTON") return;
        selectedType = e.target.getAttribute("data-type") ?? "";
        setButtonGroup(e.currentTarget, "data-type", selectedType);
        render();
      });

      document.querySelector("[data-org-buttons]")?.addEventListener("click", e => {
        if (e.target.tagName !== "BUTTON") return;
        selectedOrg = e.target.getAttribute("data-org") ?? "";
        setButtonGroup(e.currentTarget, "data-org", selectedOrg);
        render();
      });

      document.querySelector("[data-instructor-buttons]")?.addEventListener("click", e => {
        if (e.target.tagName !== "BUTTON") return;
        selectedInstructor = e.target.getAttribute("data-instructor") ?? "";
        setButtonGroup(e.currentTarget, "data-instructor", selectedInstructor);
        render();
      });

      searchEl?.addEventListener("input", () => {
        searchQuery = searchEl.value.trim();
        render();
      });

      load();
    </script>
  </div>
</Page>
