---
import Page from "../../layouts/Page.astro";
import {
  getAuthenticatedUserId,
  getClerkUserData,
  getSessionToken,
  upsertWcsProfile,
} from "../../lib/auth";
import { getApiBase } from "../../lib/api";

const runtime = Astro.locals.runtime;
const env = runtime?.env as Record<string, string> | undefined;
const apiBase = getApiBase(env?.KAIANO_API_BASE_URL);

const userId = await getAuthenticatedUserId(Astro.request, env);
const sessionToken = getSessionToken(Astro.request);
const isAuthenticated = !!userId;

let isAdmin = false;

if (userId && sessionToken && apiBase) {
  const { email, displayName } = await getClerkUserData(userId, env);
  const profile = await upsertWcsProfile(sessionToken, email, displayName, apiBase);
  isAdmin = profile?.is_admin ?? false;
}
---

<Page title="Note">
  {!isAuthenticated ? (
    <div class="flex flex-col items-center justify-center min-h-[40vh] gap-6 text-center">
      <p class="text-slate-400 font-light">This section is private.</p>
      <a
        href="/sign-in"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5 font-mono text-xs font-medium uppercase tracking-widest text-canvas transition-opacity hover:opacity-90"
      >
        Sign in →
      </a>
    </div>
  ) : (
    <div
      class="contents"
      data-notes-browser
      data-session-token={sessionToken ?? ""}
    >
      <div class="mb-4">
        <a href="/notes" class="text-xs text-slate-500 hover:text-slate-300 transition-colors">
          ← All notes
        </a>
      </div>

      <div id="note-loading" class="text-sm text-slate-500">Loading…</div>
      <div id="note-error" class="text-sm text-slate-500 hidden">Note not found.</div>
      <div id="note-content" class="space-y-8 hidden"></div>

      <script type="module">
        const BASE = document.documentElement.dataset.apiUrl || "";
        const SESSION_TOKEN =
          document.querySelector("[data-notes-browser]")?.dataset.sessionToken ?? "";
        const id = window.location.pathname.split("/").filter(Boolean).pop();
        const loadingEl = document.getElementById("note-loading");
        const errorEl = document.getElementById("note-error");
        const contentEl = document.getElementById("note-content");

        function formatDate(iso) {
          if (!iso) return "";
          return new Date(iso).toLocaleDateString("en-US", {
            year: "numeric", month: "short", day: "numeric"
          });
        }

        function show(el) { el.classList.remove("hidden"); }
        function hide(el) { el.classList.add("hidden"); }

        function sectionHeader(label) {
          const h = document.createElement("h2");
          h.className = "mb-3 text-xs font-mono uppercase tracking-widest text-slate-500";
          h.textContent = label;
          return h;
        }

        function bullet(text, dimColor = false) {
          const li = document.createElement("li");
          li.className = "flex gap-2 text-sm text-slate-300";
          const dot = document.createElement("span");
          dot.className = `mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full ${dimColor ? "bg-accent/60" : "bg-accent"}`;
          const t = document.createElement("span");
          t.textContent = text;
          li.appendChild(dot);
          li.appendChild(t);
          return li;
        }

        function asStrings(arr) {
          if (!Array.isArray(arr)) return [];
          return arr.flatMap((item) => {
            if (typeof item === "string") return [item];
            if (typeof item === "object" && item !== null) {
              const text = item.concept ?? item.action ?? item.observation ??
                item.note ?? item.name ?? item.term ?? null;
              const detail = item.detail ?? item.rationale ?? item.context ??
                item.definition ?? item.correction ?? item.description ?? item.summary ?? null;
              if (text && detail) return [String(text) + " — " + String(detail)];
              if (text) return [String(text)];
            }
            return [];
          });
        }

        function renderBulletList(label, items, dim = false) {
          const strings = asStrings(items);
          if (!strings.length) return null;
          const section = document.createElement("section");
          section.appendChild(sectionHeader(label));
          const ul = document.createElement("ul");
          ul.className = "space-y-1.5";
          strings.forEach((s) => ul.appendChild(bullet(s, dim)));
          section.appendChild(ul);
          return section;
        }

        const SESSION_LABELS = {
          private_lesson: "Private lesson",
          group_class: "Group class",
          other: "Other",
        };

        function buildDisplayTitle(note) {
          const parts = [];
          if (note.session_date) parts.push(note.session_date);
          parts.push(SESSION_LABELS[note.session_type] || note.session_type);
          if (note.session_type === "private_lesson") {
            if (note.students && note.students.length > 0) {
              parts.push(note.students.join(" + "));
            }
          } else {
            if (note.organization) parts.push(note.organization);
          }
          if (note.title && note.title.trim()) parts.push(note.title.trim());
          return parts.join(" | ");
        }

        function renderNote(note) {
          const nj = note.notes_json || {};

          const displayTitle = buildDisplayTitle(note);
          if (displayTitle) {
            document.title = displayTitle + " — Kaiano Levine";
            const h1 = document.querySelector("h1");
            if (h1) h1.textContent = displayTitle;
          }

          const existingSub = document.querySelector("header p");
          if (existingSub) existingSub.remove();

          if (nj.summary) {
            const p = document.createElement("p");
            p.className = "text-slate-300 leading-relaxed";
            p.textContent = String(nj.summary);
            contentEl.appendChild(p);
          }

          const concepts = renderBulletList("Key concepts", nj.key_concepts);
          if (concepts) contentEl.appendChild(concepts);

          if (Array.isArray(nj.vocabulary_terms) && nj.vocabulary_terms.length > 0) {
            const section = document.createElement("section");
            section.appendChild(sectionHeader("Vocabulary"));
            const dl = document.createElement("dl");
            dl.className = "space-y-2";
            nj.vocabulary_terms.forEach((item) => {
              const div = document.createElement("div");
              const dt = document.createElement("dt");
              dt.className = "text-sm font-medium text-slate-200";
              dt.textContent = String(item.term ?? "");
              div.appendChild(dt);
              if (item.definition) {
                const dd = document.createElement("dd");
                dd.className = "text-sm text-slate-400";
                dd.textContent = String(item.definition);
                div.appendChild(dd);
              }
              dl.appendChild(div);
            });
            section.appendChild(dl);
            contentEl.appendChild(section);
          }

          if (Array.isArray(nj.drills) && nj.drills.length > 0) {
            const section = document.createElement("section");
            section.appendChild(sectionHeader("Drills"));
            const wrapper = document.createElement("div");
            wrapper.className = "space-y-4";
            nj.drills.forEach((drill) => {
              const card = document.createElement("div");
              card.className = "rounded-lg border border-white/8 bg-surface/40 px-4 py-3";
              const name = document.createElement("p");
              name.className = "font-medium text-sm text-slate-200";
              name.textContent = String(drill.name ?? "");
              card.appendChild(name);
              if (drill.goal) {
                const goal = document.createElement("p");
                goal.className = "text-xs text-slate-400 mt-0.5";
                goal.textContent = String(drill.goal);
                card.appendChild(goal);
              }
              if (Array.isArray(drill.steps) && drill.steps.length > 0) {
                const ol = document.createElement("ol");
                ol.className = "mt-2 space-y-1";
                drill.steps.forEach((step, i) => {
                  const li = document.createElement("li");
                  li.className = "text-sm text-slate-300 flex gap-2";
                  const num = document.createElement("span");
                  num.className = "text-slate-600 shrink-0";
                  num.textContent = String(i + 1) + ".";
                  const t = document.createElement("span");
                  t.textContent = String(step);
                  li.appendChild(num);
                  li.appendChild(t);
                  ol.appendChild(li);
                });
                card.appendChild(ol);
              }
              wrapper.appendChild(card);
            });
            section.appendChild(wrapper);
            contentEl.appendChild(section);
          }

          if (Array.isArray(nj.common_mistakes) && nj.common_mistakes.length > 0) {
            const section = document.createElement("section");
            section.appendChild(sectionHeader("Common mistakes"));
            const wrapper = document.createElement("div");
            wrapper.className = "space-y-2";
            nj.common_mistakes.forEach((item) => {
              const div = document.createElement("div");
              div.className = "text-sm";
              const m = document.createElement("span");
              m.className = "text-slate-300";
              m.textContent = String(item.mistake ?? "");
              div.appendChild(m);
              if (item.correction) {
                const arrow = document.createElement("span");
                arrow.className = "text-slate-500";
                arrow.textContent = " → ";
                const c = document.createElement("span");
                c.className = "text-slate-300";
                c.textContent = String(item.correction);
                div.appendChild(arrow);
                div.appendChild(c);
              }
              wrapper.appendChild(div);
            });
            section.appendChild(wrapper);
            contentEl.appendChild(section);
          }

          const actions = renderBulletList("Action items", nj.action_items, true);
          if (actions) contentEl.appendChild(actions);

          const obs = renderBulletList("Observations", nj.student_observations);
          if (obs) contentEl.appendChild(obs);

          if (Array.isArray(nj.quotes) && nj.quotes.length > 0) {
            const section = document.createElement("section");
            section.appendChild(sectionHeader("Quotes"));
            const wrapper = document.createElement("div");
            wrapper.className = "space-y-3";
            nj.quotes.forEach((q) => {
              const quote = typeof q === "string" ? q : String(q.quote ?? "");
              const speaker = typeof q === "object" ? String(q.speaker ?? "") : "";
              const bq = document.createElement("blockquote");
              bq.className = "border-l-2 border-accent/40 pl-4";
              const p = document.createElement("p");
              p.className = "text-sm italic text-slate-300";
              p.textContent = "\u201c" + quote + "\u201d";
              bq.appendChild(p);
              if (speaker) {
                const cite = document.createElement("p");
                cite.className = "mt-1 text-xs text-slate-500";
                cite.textContent = "— " + speaker;
                bq.appendChild(cite);
              }
              wrapper.appendChild(bq);
            });
            section.appendChild(wrapper);
            contentEl.appendChild(section);
          }

          const refs = renderBulletList("References", nj.references);
          if (refs) contentEl.appendChild(refs);

          if (Array.isArray(nj.suggested_new_sections) && nj.suggested_new_sections.length > 0) {
            const section = document.createElement("section");
            section.className = "rounded-lg border border-amber-500/20 bg-amber-500/5 px-4 py-4";
            section.appendChild(sectionHeader("Schema feedback"));
            const wrapper = document.createElement("div");
            wrapper.className = "space-y-3";
            nj.suggested_new_sections.forEach((s) => {
              const div = document.createElement("div");
              const name = document.createElement("p");
              name.className = "text-sm font-medium text-amber-400/80";
              name.textContent = String(s.suggested_name ?? "");
              div.appendChild(name);
              if (s.rationale) {
                const r = document.createElement("p");
                r.className = "text-xs text-slate-500 mt-0.5";
                r.textContent = String(s.rationale);
                div.appendChild(r);
              }
              if (s.sample_content) {
                const sc = document.createElement("p");
                sc.className = "text-xs text-slate-600 mt-1 italic";
                sc.textContent = String(s.sample_content);
                div.appendChild(sc);
              }
              wrapper.appendChild(div);
            });
            section.appendChild(wrapper);
            contentEl.appendChild(section);
          }

          const footer = document.createElement("div");
          footer.className = "border-t border-white/8 pt-4 text-xs text-slate-600";
          footer.textContent = "Processed " + formatDate(note.created_at) + " · " + note.provider + "/" + note.model;
          contentEl.appendChild(footer);
        }

        async function load() {
          if (!BASE || !id) { hide(loadingEl); show(errorEl); return; }
          try {
            const res = await fetch(`${BASE.replace(/\/$/, "")}/v1/wcs/notes/${id}`, {
              headers: SESSION_TOKEN
                ? { Authorization: `Bearer ${SESSION_TOKEN}` }
                : {},
            });
            if (res.status === 403) {
              errorEl.textContent = "You don't have access to this note.";
              throw new Error("forbidden");
            }
            if (!res.ok) throw new Error("not found");
            const json = await res.json();
            const note = json.data;
            if (!note) throw new Error("no data");
            hide(loadingEl);
            renderNote(note);
            show(contentEl);
          } catch {
            hide(loadingEl);
            show(errorEl);
          }
        }

        load();
      </script>
    </div>
  )}
</Page>