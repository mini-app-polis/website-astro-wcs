---
import Page from "../../../layouts/Page.astro";
import {
  getAuthenticatedUserId,
  getClerkUserData,
  getSessionToken,
  upsertWcsProfile,
} from "../../../lib/auth";
import { getApiBase } from "../../../lib/api";

const runtime = Astro.locals.runtime;
const env = runtime?.env as Record<string, string> | undefined;
const apiBase = getApiBase(env?.KAIANO_API_BASE_URL);

const userId = await getAuthenticatedUserId(Astro.request, env);
const sessionToken = getSessionToken(Astro.request);

if (!userId || !sessionToken) {
  return Astro.redirect("/sign-in");
}

const { email, displayName } = await getClerkUserData(userId, env);
const profile = apiBase ? await upsertWcsProfile(sessionToken, email, displayName, apiBase) : null;

if (!profile?.is_admin) {
  return Astro.redirect("/notes");
}

const { id } = Astro.params;
---

<Page title="Lesson (Admin)" subtitle="Full source view">
  <div
    class="contents"
    data-notes-browser
    data-session-token={sessionToken}
    data-source-id={id ?? ""}
    data-mode="admin"
  >
    <div class="mb-4">
      <a href="/notes/admin" class="text-xs text-slate-500 hover:text-slate-300 transition-colors">
        ← All notes (admin)
      </a>
    </div>

    <div id="note-loading" class="text-sm text-slate-500">Loading…</div>
    <div id="note-error" class="text-sm text-slate-500 hidden">Source not found.</div>
    <div id="note-content" class="space-y-8 hidden"></div>
  </div>

  <script is:inline src="/wcs-source-detail.js"></script>
</Page>
