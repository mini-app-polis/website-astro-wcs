---
import Page from "../../layouts/Page.astro";
import { getAuthenticatedUserId } from "../../lib/auth";

const runtime = Astro.locals.runtime;
const userId = await getAuthenticatedUserId(Astro.request, runtime?.env);
const allowedUserId = runtime?.env?.NOTES_ALLOWED_USER_ID ?? import.meta.env.NOTES_ALLOWED_USER_ID;

const isAuthenticated = !!userId;
const isAuthorized = userId === allowedUserId;
---

<Page title="Notes" subtitle="WCS lesson notes">
  {!isAuthenticated ? (
    <div class="flex flex-col items-center justify-center min-h-[40vh] gap-6 text-center">
      <p class="text-slate-400 font-light">This section is private.</p>
      <a
        href="/sign-in"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5 font-mono text-xs font-medium uppercase tracking-widest text-canvas transition-opacity hover:opacity-90"
      >
        Sign in →
      </a>
    </div>
  ) : !isAuthorized ? (
    <div class="flex flex-col items-center justify-center min-h-[40vh] gap-3 text-center">
      <p class="text-slate-400 font-light">You don't have access to this section.</p>
    </div>
  ) : (
    <div class="contents">
      <div id="notes-loading" class="text-sm text-slate-500">Loading…</div>
      <div id="notes-error" class="text-sm text-slate-500 hidden">Could not load notes.</div>
      <div id="notes-empty" class="text-sm text-slate-500 hidden">No notes yet.</div>
      <div id="notes-list" class="space-y-3 hidden"></div>

      <script type="module">
        const BASE = document.documentElement.dataset.apiUrl || "";
        const loadingEl = document.getElementById("notes-loading");
        const errorEl = document.getElementById("notes-error");
        const emptyEl = document.getElementById("notes-empty");
        const listEl = document.getElementById("notes-list");

        const SESSION_LABELS = {
          private_lesson: "Private lesson",
          group_class: "Group class",
          other: "Other",
        };

        function buildDisplayTitle(note) {
          const parts = [];

          if (note.session_date) parts.push(note.session_date);

          parts.push(SESSION_LABELS[note.session_type] || note.session_type);

          if (note.session_type === "private_lesson") {
            if (note.students && note.students.length > 0) {
              parts.push(note.students.join(" + "));
            }
          } else {
            if (note.organization) parts.push(note.organization);
          }

          if (note.title && note.title.trim()) parts.push(note.title.trim());

          return parts.join(" | ");
        }

        function show(el) {
          el.classList.remove("hidden");
        }
        function hide(el) {
          el.classList.add("hidden");
        }

        async function load() {
          if (!BASE) {
            hide(loadingEl);
            show(errorEl);
            return;
          }
          try {
            const res = await fetch(`${BASE.replace(/\/$/, "")}/v1/wcs/notes?limit=100`);
            if (!res.ok) throw new Error("bad response");
            const json = await res.json();
            const notes = json.data ?? [];
            hide(loadingEl);
            if (notes.length === 0) {
              show(emptyEl);
              return;
            }

            for (const note of notes) {
              const a = document.createElement("a");
              a.href = `/notes/${note.id}`;
              a.className =
                "block rounded-xl border border-white/8 bg-surface/60 px-5 py-4 transition-colors hover:border-accent/30 hover:bg-surface";

              const title = document.createElement("p");
              title.className = "font-medium text-slate-100 text-sm";
              title.textContent = buildDisplayTitle(note);

              a.appendChild(title);
              listEl.appendChild(a);
            }

            show(listEl);
          } catch {
            hide(loadingEl);
            show(errorEl);
          }
        }

        load();
      </script>
    </div>
  )}
</Page>
