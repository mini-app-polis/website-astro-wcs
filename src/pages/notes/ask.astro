---
import Page from "../../layouts/Page.astro";
import {
  getAuthenticatedUserId,
  getClerkUserData,
  getSessionToken,
  upsertWcsProfile,
} from "../../lib/auth";
import { getApiBase } from "../../lib/api";

const runtime = Astro.locals.runtime;
const env = runtime?.env as Record<string, string> | undefined;
const apiBase = getApiBase(env?.KAIANO_API_BASE_URL);

const userId = await getAuthenticatedUserId(Astro.request, env);
const sessionToken = getSessionToken(Astro.request);

// Admin-only for now. Loosen to all signed-in users once the agent is
// ready for general access (drop the is_admin check; keep the sign-in
// guard).
if (!userId || !sessionToken) {
  return Astro.redirect("/sign-in");
}

const { email, displayName } = await getClerkUserData(userId, env);
const profile = apiBase
  ? await upsertWcsProfile(sessionToken, email, displayName, apiBase)
  : null;

if (!profile?.is_admin) {
  return Astro.redirect("/notes");
}
---

<Page title="Ask" subtitle="Ask the agent about your WCS lesson notes">
  <div
    class="contents"
    data-ask-app
    data-session-token={sessionToken ?? ""}
  >
      <form id="ask-form" class="space-y-3">
        <label for="ask-input" class="block text-xs font-mono text-slate-500">
          Question
        </label>
        <textarea
          id="ask-input"
          rows="3"
          maxlength="5000"
          placeholder="What did Kyle teach about anchor step timing?"
          class="w-full rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 text-sm text-slate-200 placeholder:text-slate-600 outline-none focus:border-accent/50 transition-colors resize-none"
        ></textarea>
        <div class="flex items-center justify-between gap-3">
          <p class="text-xs text-slate-600">
            Single-turn — each question is independent.
          </p>
          <button
            id="ask-submit"
            type="submit"
            disabled
            class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5 font-mono text-xs font-semibold text-canvas transition-opacity hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <span id="ask-submit-label">Ask →</span>
          </button>
        </div>
      </form>

      <div
        id="ask-loading"
        class="hidden mt-8 flex items-center gap-3 text-sm text-slate-400"
        role="status"
        aria-live="polite"
      >
        <span class="inline-flex items-center gap-1" aria-hidden="true">
          <span class="h-1.5 w-1.5 rounded-full bg-accent/80 animate-pulse" style="animation-delay: 0ms;"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-accent/80 animate-pulse" style="animation-delay: 200ms;"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-accent/80 animate-pulse" style="animation-delay: 400ms;"></span>
        </span>
        <span id="ask-loading-text">Thinking…</span>
        <span id="ask-loading-elapsed" class="ml-auto font-mono text-xs text-slate-600"></span>
      </div>
      <div id="ask-error" class="hidden mt-8 rounded-xl border border-red-500/20 bg-red-500/5 px-4 py-3 text-sm text-red-300">
        Something went wrong. Try again, or check the API status.
      </div>

      <article id="ask-result" class="hidden mt-8 space-y-6">
        <div
          id="ask-budget-warning"
          class="hidden rounded-xl border border-amber-500/25 bg-amber-500/5 px-4 py-3 text-xs text-amber-200 font-mono"
        >
          ⚠ This answer may be incomplete — the agent ran out of its tool or token budget.
        </div>

        <div
          id="ask-answer"
          class="text-base text-slate-100 leading-relaxed"
          style="white-space: pre-wrap;"
        ></div>

        <div id="ask-sources-section" class="hidden border-t border-white/8 pt-6">
          <h3 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-4">
            Sources
          </h3>
          <ol id="ask-citations" class="space-y-3 list-none p-0"></ol>
        </div>

        <p
          id="ask-trace"
          class="text-[0.65rem] font-mono text-slate-700"
        ></p>
      </article>

      <script type="module">
        const BASE = document.documentElement.dataset.apiUrl || "";
        const SESSION_TOKEN =
          document.querySelector("[data-ask-app]")?.dataset.sessionToken ?? "";

        const form           = document.getElementById("ask-form");
        const input          = document.getElementById("ask-input");
        const submitBtn      = document.getElementById("ask-submit");
        const submitLabel    = document.getElementById("ask-submit-label");
        const loadingEl      = document.getElementById("ask-loading");
        const loadingTextEl  = document.getElementById("ask-loading-text");
        const loadingTimeEl  = document.getElementById("ask-loading-elapsed");
        const errorEl        = document.getElementById("ask-error");
        const resultEl       = document.getElementById("ask-result");
        const budgetEl       = document.getElementById("ask-budget-warning");
        const answerEl       = document.getElementById("ask-answer");
        const sourcesEl      = document.getElementById("ask-sources-section");
        const citationsEl    = document.getElementById("ask-citations");
        const traceEl        = document.getElementById("ask-trace");

        // Phased loading feedback — message advances based on elapsed
        // seconds. Thresholds are tuned to roughly track the typical agent
        // sequence (search → read → synthesize). They aren't tied to actual
        // backend events, but they describe what the agent is genuinely
        // doing most of the time, so they're honest by construction.
        const LOADING_PHASES = [
          { atSec: 0,  text: "Thinking…" },
          { atSec: 3,  text: "Searching your notes…" },
          { atSec: 8,  text: "Reading lesson details…" },
          { atSec: 18, text: "Pulling related sessions…" },
          { atSec: 35, text: "Synthesizing across notes…" },
          { atSec: 70, text: "Still working — complex questions take longer…" },
        ];
        let loadingTimer = null;
        let loadingStartedAt = 0;

        function startLoadingFeedback() {
          loadingStartedAt = Date.now();
          loadingTextEl.textContent = LOADING_PHASES[0].text;
          loadingTimeEl.textContent = "0s";
          // Update twice a second — cheap, and elapsed counter looks live.
          loadingTimer = setInterval(() => {
            const sec = Math.floor((Date.now() - loadingStartedAt) / 1000);
            let phaseText = LOADING_PHASES[0].text;
            for (const p of LOADING_PHASES) {
              if (sec >= p.atSec) phaseText = p.text;
            }
            loadingTextEl.textContent = phaseText;
            loadingTimeEl.textContent = `${sec}s`;
          }, 500);
        }

        function stopLoadingFeedback() {
          if (loadingTimer !== null) {
            clearInterval(loadingTimer);
            loadingTimer = null;
          }
        }

        // Mirrors the constants used by /notes (notes browser) so citation
        // cards label sessions the same way users already recognize.
        const SESSION_LABELS = {
          private_lesson: "Private lesson",
          group_class:    "Group class",
          other:          "Other",
        };

        const TYPE_BADGE = {
          private_lesson: "bg-violet-500/10 text-violet-300 border-violet-500/25",
          group_class:    "bg-sky-500/10 text-sky-300 border-sky-500/25",
          other:          "bg-slate-500/10 text-slate-400 border-slate-500/25",
        };

        // Fallback badge styling for chunk citations that have no linked note
        // (no session_type to derive from) — labelled "Transcript" instead.
        const TRANSCRIPT_BADGE_CLS =
          "bg-slate-500/10 text-slate-400 border-slate-500/25";

        const show = el => el.classList.remove("hidden");
        const hide = el => el.classList.add("hidden");

        // Same as /notes — primary "with" label depends on session_type.
        function noteInstructors(c) {
          return c.instructors?.length ? c.instructors.join(" + ") : "";
        }
        function noteWith(c) {
          if (c.session_type === "private_lesson") {
            return c.students?.length ? c.students.join(" + ") : "";
          }
          return c.organization || "";
        }

        function setSubmitting(on) {
          submitBtn.disabled = on || !input.value.trim();
          submitLabel.textContent = on ? "Asking…" : "Ask →";
        }

        function formatDate(iso) {
          if (!iso) return "";
          const [y, m, d] = iso.split("-").map(Number);
          if (!y || !m || !d) return "";
          return new Date(y, m - 1, d).toLocaleDateString("en-US", {
            month: "short", day: "numeric", year: "numeric",
          });
        }

        function renderAnswer(text) {
          answerEl.innerHTML = "";
          const parts = text.split(/(\[\d+\])/g);
          for (const part of parts) {
            const m = part.match(/^\[(\d+)\]$/);
            if (m) {
              const sup = document.createElement("sup");
              sup.className = "ml-0.5";
              const a = document.createElement("a");
              a.href = `#citation-${m[1]}`;
              a.textContent = part;
              a.className =
                "text-accent hover:underline font-mono text-xs no-underline";
              sup.appendChild(a);
              answerEl.appendChild(sup);
            } else {
              answerEl.appendChild(document.createTextNode(part));
            }
          }
        }

        function renderCitation(c) {
          const li = document.createElement("li");
          li.id = `citation-${c.marker}`;
          li.className = "flex items-start gap-3";

          // Marker badge (anchor target for inline [N] markers in the answer).
          const marker = document.createElement("span");
          marker.className =
            "mt-3 shrink-0 inline-flex items-center justify-center h-6 w-6 rounded-full border border-accent/30 bg-accent/10 text-accent font-mono text-xs";
          marker.textContent = String(c.marker);
          li.appendChild(marker);

          // Card body — wrap in <a> when we have a source_url so the whole
          // card is clickable (matches the /notes browser cards).
          const linkable = !!c.source_url;
          const body = document.createElement(linkable ? "a" : "div");
          if (linkable) body.href = c.source_url;
          body.className =
            "flex-1 min-w-0 flex flex-col gap-2 rounded-lg border border-white/8 bg-surface/40 px-4 py-3" +
            (linkable
              ? " transition-colors hover:border-accent/25 hover:bg-surface"
              : "");

          // Top row: date (left) + session-type badge (right). Chunk citations
          // without a linked note have no session_type → render as "Transcript".
          const topRow = document.createElement("div");
          topRow.className = "flex items-center justify-between gap-2";

          const dateEl = document.createElement("span");
          dateEl.className = "font-mono text-xs text-slate-200 font-medium";
          dateEl.textContent = c.session_date ? formatDate(c.session_date) : "";

          let badgeText, badgeCls;
          if (c.session_type) {
            badgeText = SESSION_LABELS[c.session_type] || c.session_type;
            badgeCls = TYPE_BADGE[c.session_type] || TYPE_BADGE.other;
          } else {
            badgeText = "Transcript";
            badgeCls = TRANSCRIPT_BADGE_CLS;
          }
          const badge = document.createElement("span");
          badge.className =
            `inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-mono ${badgeCls}`;
          badge.textContent = badgeText;

          topRow.appendChild(dateEl);
          topRow.appendChild(badge);
          body.appendChild(topRow);

          // Primary label (students for private lessons, otherwise org) +
          // "[with instructors]" suffix — same as /notes.
          const primaryLabel = noteWith(c);
          const instructors = noteInstructors(c);
          if (primaryLabel) {
            const primaryEl = document.createElement("p");
            primaryEl.className = "text-sm font-medium text-slate-100 leading-snug";

            const nameSpan = document.createElement("span");
            nameSpan.textContent = primaryLabel;
            primaryEl.appendChild(nameSpan);

            if (instructors) {
              const withSpan = document.createElement("span");
              withSpan.className = "font-normal text-slate-500";
              withSpan.textContent = " [with " + instructors + "]";
              primaryEl.appendChild(withSpan);
            }
            body.appendChild(primaryEl);
          }

          // Title row — dimmed when there's a primary label above (acts as a
          // sub-label), primary-styled when it's the only thing we have to
          // show. Only fall back to "Untitled" when we have *nothing* — date,
          // primary label, and title are all empty.
          const rawTitle = (c.title || "").trim();
          const titleText =
            rawTitle || (primaryLabel || c.session_date ? "" : "Untitled");
          if (titleText) {
            const titleEl = document.createElement("p");
            titleEl.className = primaryLabel
              ? "text-sm text-slate-400 leading-snug"
              : "text-sm font-medium text-slate-100 leading-snug";
            titleEl.textContent = titleText;
            body.appendChild(titleEl);
          }

          li.appendChild(body);
          return li;
        }

        function renderResult(data) {
          hide(loadingEl);
          hide(errorEl);

          if (data.budget_exhausted) show(budgetEl); else hide(budgetEl);

          renderAnswer(data.answer || "");

          citationsEl.innerHTML = "";
          const citations = Array.isArray(data.citations) ? data.citations : [];
          if (citations.length > 0) {
            for (const c of citations) citationsEl.appendChild(renderCitation(c));
            show(sourcesEl);
          } else {
            hide(sourcesEl);
          }

          traceEl.textContent = buildTraceLine(data);

          show(resultEl);
        }

        // Compact "K" formatter for token counts. 4096 → "4.1K", 580 → "580".
        function formatTokens(n) {
          if (typeof n !== "number" || !isFinite(n) || n < 0) return "";
          if (n < 1000) return String(n);
          return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
        }

        function formatCost(usd) {
          if (typeof usd !== "number" || !isFinite(usd)) return "";
          // Four decimal places: enough resolution for sub-cent runs without
          // pretending we know better. Strip trailing zeros for readability.
          return "$" + usd.toFixed(4).replace(/0+$/, "").replace(/\.$/, ".0");
        }

        // Build the small grey "trace + usage" footer line that appears under
        // the citations. Pieces are omitted gracefully when the field is
        // missing (the backend drops cost_usd when the model isn't priced).
        function buildTraceLine(data) {
          const parts = [];
          if (data.tool_trace_id) parts.push(`trace: ${data.tool_trace_id}`);
          const u = data.usage;
          if (u) {
            if (typeof u.cost_usd === "number") parts.push(formatCost(u.cost_usd));
            const tok =
              formatTokens(u.input_tokens) + " in / " + formatTokens(u.output_tokens) + " out";
            parts.push(tok);
            if (u.model) parts.push(u.model);
          }
          return parts.join(" · ");
        }

        async function ask(question) {
          if (!BASE) {
            show(errorEl);
            return;
          }
          hide(resultEl);
          hide(errorEl);
          show(loadingEl);
          startLoadingFeedback();
          setSubmitting(true);
          try {
            const res = await fetch(`${BASE.replace(/\/$/, "")}/v1/wcs/ask`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                ...(SESSION_TOKEN
                  ? { Authorization: `Bearer ${SESSION_TOKEN}` }
                  : {}),
              },
              body: JSON.stringify({ question }),
            });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const json = await res.json();
            renderResult(json.data ?? {});
          } catch (err) {
            hide(loadingEl);
            hide(resultEl);
            show(errorEl);
          } finally {
            stopLoadingFeedback();
            setSubmitting(false);
          }
        }

        input.addEventListener("input", () => setSubmitting(false));

        form.addEventListener("submit", e => {
          e.preventDefault();
          const q = input.value.trim();
          if (!q) return;
          ask(q);
        });

        // Cmd/Ctrl-Enter submits.
        input.addEventListener("keydown", e => {
          if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
            e.preventDefault();
            form.requestSubmit();
          }
        });

        setSubmitting(false);
      </script>
    </div>
</Page>
