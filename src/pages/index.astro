---
import Base from "../layouts/Base.astro";
import StatsBar from "../components/StatsBar.astro";

const cards = [
  {
    title: "DJ Marvel",
    description: "Full set history, live plays, and catalog — powered by deejay-marvel-api.",
    status: "Live",
    live: true,
    href: "/dj-marvel",
  },
  {
    title: "WCS Lessons",
    description: "Private lessons across Twin Cities, SWINGesota, and conventions.",
    status: "Booking",
    live: false,
    href: "/booking/lessons",
  },
  {
    title: "Music Catalog",
    description: "Top artists and tracks from the full DJ history, updated live.",
    status: "Live",
    live: true,
    href: "/catalog",
  },
] as const;
---

<Base title="Kaiano Levine — West Coast Swing">
  <!-- Hero -->
  <div class="-mx-6 -mt-10 grid grid-cols-2">
    <div class="flex flex-col justify-center gap-7 px-6 py-20 sm:px-10">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">
        West Coast Swing · Twin Cities, MN
      </p>
      <h1 class="font-display text-6xl font-black italic leading-[0.95] tracking-tight sm:text-7xl">
        <span class="text-accent">Kaiano</span><br />Levine
      </h1>
      <p class="max-w-xs text-sm font-light leading-relaxed text-slate-400">
        DJ, instructor, and dance community builder — harnessing the power of swing.
      </p>
      <div class="flex items-center gap-3">
        <a
          href="/booking/lessons"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-mono text-xs font-medium uppercase tracking-widest text-bg transition-opacity hover:opacity-90"
        >
          Book a Lesson →
        </a>
        <a
          href="/dj-marvel"
          class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-3 font-mono text-xs uppercase tracking-wider text-slate-400 transition-colors hover:border-accent hover:text-accent"
        >
          DJ Marvel
        </a>
      </div>
    </div>

    <div class="relative flex items-center justify-center overflow-hidden bg-surface">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_60%_40%,rgba(52,211,153,0.06),transparent_65%)]"></div>
      <div class="relative z-10 flex flex-col items-center gap-4">
        <img
          src="/images/kaiano.jpg"
          alt="Kaiano Levine"
          class="h-36 w-36 rounded-full border-2 border-accent/30 object-cover object-top"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
        />
        <div
          class="hidden h-36 w-36 items-center justify-center rounded-full border-2 border-accent/30 bg-surface2 font-display text-4xl font-bold italic text-accent"
        >
          KL
        </div>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="-mx-6 border-y border-white/[0.07] bg-bg2">
    <StatsBar />
  </div>

  <!-- Cards -->
  <section class="space-y-5 pt-10">
    <p class="font-mono text-[9px] uppercase tracking-[0.15em] text-accent/60">What's here</p>
    <div class="grid gap-3 md:grid-cols-3">
      {cards.map((card) => (
        <a
          href={card.href}
          class="group flex flex-col gap-3 rounded-2xl border border-white/[0.07] bg-surface p-6 transition-colors hover:border-accent/20 hover:bg-surface2"
        >
          <span
            class={`self-start rounded-full border px-2.5 py-0.5 font-mono text-[9px] uppercase tracking-widest ${
              card.live
                ? "border-accent/20 bg-accent/10 text-accent"
                : "border-white/10 bg-white/[0.04] text-slate-500"
            }`}
          >
            {card.status}
          </span>
          <h3 class="font-display text-lg font-bold italic transition-colors group-hover:text-accent">
            {card.title}
          </h3>
          <p class="text-sm font-light leading-relaxed text-slate-400">{card.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
