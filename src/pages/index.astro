---
import Base from "../layouts/Base.astro";
import StatsBar from "../components/StatsBar.astro";

const cards = [
  {
    title: "DJ Marvel",
    description: "Set history, live plays, and music catalog — all powered by deejay-marvel-api.",
    status: "Live",
    statusColor: "accent",
    href: "/dj-marvel",
  },
  {
    title: "WCS Lessons",
    description: "Private lessons across the Twin Cities, SWINGesota, and weekend conventions.",
    status: "Booking",
    statusColor: "blue",
    href: "/booking/lessons",
  },
  {
    title: "Music Catalog",
    description: "Top artists and tracks from the full DJ history, pulled live from the API.",
    status: "Live",
    statusColor: "accent",
    href: "/catalog",
  },
] as const;
---

<Base title="Kaiano Levine — West Coast Swing">
  <section class="space-y-10 pb-4 pt-2">
    <div class="space-y-4">
      <h1 class="font-display text-5xl tracking-tight sm:text-6xl">
        Kaiano Levine
      </h1>
      <div class="flex flex-wrap items-baseline gap-3">
        <h2 class="font-display text-2xl tracking-tight text-slate-100">
          West Coast Swing
        </h2>
        <p class="max-w-lg text-sm text-slate-400">
          DJ and instructor based in the Twin Cities, MN. Harnessing the power of swing.
        </p>
      </div>
    </div>

    <StatsBar />

    <div class="grid gap-5 md:grid-cols-3">
      {cards.map((card) => (
        <a
          href={card.href}
          class="group flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.02] p-5 shadow-soft transition-colors hover:border-white/20 hover:bg-white/[0.04]"
        >
          <span
            class={`self-start rounded-full border px-2.5 py-0.5 font-mono text-xs font-medium ${
              card.statusColor === "accent"
                ? "border-accent/30 bg-accent/10 text-accent"
                : "border-blue-400/30 bg-blue-400/10 text-blue-300"
            }`}
          >
            {card.status}
          </span>
          <h3 class="font-display text-lg tracking-tight transition-colors group-hover:text-accent">
            {card.title}
          </h3>
          <p class="text-sm leading-relaxed text-slate-400">{card.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
