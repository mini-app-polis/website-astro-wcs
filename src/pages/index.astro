---
import Base from "../layouts/Base.astro";
import StatsBar from "../components/StatsBar.astro";

const cards = [
  {
    title: "DJ Marvel",
    description: "Full set history, live plays, and catalog.",
    status: "Live",
    href: "/dj-marvel",
  },
  {
    title: "WCS Lessons",
    description: "Private lessons across Twin Cities, SWINGesota, and conventions.",
    status: "Booking",
    href: "/booking/lessons",
  },
  {
    title: "Stats",
    description: "Top artists and tracks from the full DJ history, updated live.",
    status: "Live",
    href: "/catalog",
  },
  {
    title: "Locate",
    description: "Find Kaiano at upcoming events and conventions.",
    status: null,
    href: "/locate",
  },
  {
    title: "Contact",
    description: "Get in touch with Kaiano directly.",
    status: null,
    href: "/contact",
  },
  {
    title: "Submit Music",
    description: "Submit a track for consideration in a WCS set.",
    status: null,
    href: "/submit-music",
  },
] as const;
---

<Base title="Kaiano Levine — West Coast Swing">
  <!-- Hero -->
  <div class="-mx-6 -mt-10 grid grid-cols-1 min-h-[480px] sm:grid-cols-[5fr_3fr]">
    <div class="flex flex-col justify-center gap-7 px-10 py-20">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">
        West Coast Swing · Twin Cities, MN
      </p>
      <h1 class="font-serif text-6xl font-black italic leading-[0.95] tracking-tight sm:text-7xl" style="font-variation-settings: 'opsz' 72;">
        <span class="text-accent">Kaiano</span><br />Levine
      </h1>
      <p class="max-w-xs text-sm font-light leading-relaxed text-slate-400">
        DJ, instructor, and dance community builder — harnessing the power of swing.
      </p>
      <div class="flex items-center gap-3">
        <a
          href="/booking/lessons"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-mono text-xs font-medium uppercase tracking-widest text-canvas transition-opacity hover:opacity-90"
        >
          Book a Lesson →
        </a>
      </div>
    </div>

    <div class="relative hidden overflow-hidden sm:block">
      <div class="absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-canvas to-transparent"></div>
      <img
        src="/kaiano.png"
        alt="Kaiano Levine"
        class="h-full w-full object-cover object-top"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
      />
      <div class="hidden h-full w-full items-center justify-center bg-surface font-serif italic text-6xl text-accent/20">
        KL
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="-mx-6 border-y border-white/[0.07] bg-canvas2">
    <div class="mx-auto max-w-5xl px-6 pt-4">
      <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-accent/50">DJ Marvel</p>
    </div>
    <StatsBar />
  </div>

  <!-- Cards -->
  <section class="space-y-5 pt-10">
    <p class="font-mono text-[9px] uppercase tracking-[0.15em] text-accent/60">Quick Links</p>
    <div class="grid gap-3 md:grid-cols-3">
      {cards.map((card) => (
        <a
          href={card.href}
          class="group rounded-xl border border-white/[0.07] bg-surface px-5 py-4 transition-colors hover:border-accent/30"
        >
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-serif text-base font-bold italic transition-colors group-hover:text-accent" style="font-variation-settings: 'opsz' 72;">
              {card.title}
            </h3>
            <span class="font-mono text-xs uppercase tracking-wider text-slate-500 transition-colors group-hover:text-accent">
              Open →
            </span>
          </div>
          <p class="mt-1 text-sm text-slate-400 transition-colors group-hover:text-slate-300">{card.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
