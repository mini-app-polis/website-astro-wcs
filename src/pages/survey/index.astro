---
import Page from "../../layouts/Page.astro";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "0x4AAAAAACXUS6RYhJCvPzZg";
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "https://api.kaianolevine.com";

const inputClass = "w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 transition-colors focus:border-white/25 focus:outline-none";
const labelClass = "text-xs font-medium uppercase tracking-widest text-slate-400";
---

<Page title="Student Survey" subtitle="Thanks for taking the time to share your thoughts!">
  <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 shadow-soft max-w-2xl">

    <div id="surveySuccess" class="hidden space-y-2 py-6 text-center">
      <p class="font-serif italic text-2xl tracking-tight text-accent">Survey submitted!</p>
      <p class="text-sm text-slate-400">Thank you — Kaiano will review before your lesson.</p>
    </div>

    <div id="surveyError" class="mb-5 hidden rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3">
      <p class="text-sm text-red-400" id="surveyErrorMsg">Something went wrong. Please refresh and try again.</p>
    </div>

    <form id="surveyForm" class="space-y-5" novalidate>
      <input type="hidden" name="type" value="survey" />
      <input type="hidden" name="originSite" value="wcs.kaianolevine.com" />

      <div style="display:none" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="space-y-1.5">
          <label class={labelClass}>First name</label>
          <input type="text" name="first" required autocomplete="given-name" class={inputClass} />
        </div>
        <div class="space-y-1.5">
          <label class={labelClass}>Last name</label>
          <input type="text" name="lastName" required autocomplete="family-name" class={inputClass} />
        </div>
        <div class="space-y-1.5">
          <label class={labelClass}>Preferred name</label>
          <input type="text" name="preferredName" placeholder="If different from first name" class={inputClass} />
        </div>
        <div class="space-y-1.5">
          <label class={labelClass}>Pronouns</label>
          <input type="text" name="pronouns" required placeholder="e.g. she/her, they/them" class={inputClass} />
        </div>
        <div class="space-y-1.5 sm:col-span-2">
          <label class={labelClass}>Email address</label>
          <input type="email" name="replyTo" required autocomplete="email" class={inputClass} />
        </div>
      </div>

      <div class="space-y-1.5">
        <label class={labelClass}>What is your primary role (lead, follow, or both)? Which role do you want to focus on?</label>
        <textarea name="role-choice" rows="4" required class={inputClass}></textarea>
      </div>
      <div class="space-y-1.5">
        <label class={labelClass}>What is your movement background?</label>
        <p class="text-xs text-slate-500">Dance, athletics, anything you feel may be related. Feel free to think outside the box.</p>
        <textarea name="movement-background" rows="4" required class={inputClass}></textarea>
      </div>
      <div class="space-y-1.5">
        <label class={labelClass}>What is your education/career background?</label>
        <p class="text-xs text-slate-500">Anything that demonstrates how you think about the world.</p>
        <textarea name="education-background" rows="4" class={inputClass}></textarea>
      </div>
      <div class="space-y-1.5">
        <label class={labelClass}>Who inspires you, and what about them inspires you?</label>
        <p class="text-xs text-slate-500">Local dancers or international professionals.</p>
        <textarea name="inspiration" rows="4" class={inputClass}></textarea>
      </div>
      <div class="space-y-1.5">
        <label class={labelClass}>How do you most effectively learn?</label>
        <p class="text-xs text-slate-500">Visual, auditory, kinesthetic — or describe in your own words.</p>
        <textarea name="learning-style" rows="4" class={inputClass}></textarea>
      </div>
      <div class="space-y-1.5">
        <label class={labelClass}>What are your goals in dance?</label>
        <p class="text-xs text-slate-500">Short or long term.</p>
        <textarea name="goals" rows="4" class={inputClass}></textarea>
      </div>
      <div class="space-y-1.5">
        <label class={labelClass}>How would you like to measure success from lessons?</label>
        <textarea name="success-measurement" rows="4" class={inputClass}></textarea>
      </div>
      <div class="space-y-1.5">
        <label class={labelClass}>Is there anything specific you want to work on?</label>
        <textarea name="lesson-content-requests" rows="4" class={inputClass}></textarea>
      </div>

      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>

      <button
        id="surveySubmit"
        type="submit"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5 font-mono text-sm font-semibold text-black transition-opacity hover:opacity-90 disabled:opacity-50"
      >
        <span id="surveySubmitLabel">Submit Survey →</span>
      </button>
    </form>
  </div>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script define:vars={{ apiUrl }}>
    const form = document.getElementById("surveyForm");
    const submitBtn = document.getElementById("surveySubmit");
    const submitLabel = document.getElementById("surveySubmitLabel");
    const successEl = document.getElementById("surveySuccess");
    const errorEl = document.getElementById("surveyError");
    const errorMsg = document.getElementById("surveyErrorMsg");

    if (form && submitBtn && submitLabel && successEl && errorEl && errorMsg) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.add("hidden");

        const data = new FormData(form);

        if (!data.get("replyTo") || !data.get("first")) {
          errorMsg.textContent = "Please fill in all required fields.";
          errorEl.classList.remove("hidden");
          return;
        }

        const token = data.get("cf-turnstile-response");
        if (!token) {
          errorMsg.textContent = "Please complete the verification check.";
          errorEl.classList.remove("hidden");
          return;
        }

        submitBtn.disabled = true;
        submitLabel.textContent = "Submitting…";

        try {
          const res = await fetch(`${apiUrl}/v1/contact`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(Object.fromEntries(data)),
            redirect: "manual",
          });

          const isSuccess = res.ok || res.type === "opaqueredirect";
          if (!isSuccess) {
            const text = await res.text().catch(() => "");
            throw new Error(text || `Error ${res.status}`);
          }

          form.classList.add("hidden");
          successEl.classList.remove("hidden");
        } catch (err) {
          errorMsg.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
          errorEl.classList.remove("hidden");
          submitBtn.disabled = false;
          submitLabel.textContent = "Submit Survey →";
        }
      });
    }
  </script>
</Page>