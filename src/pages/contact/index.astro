---
import Page from "../../layouts/Page.astro";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "0x4AAAAAACXUS6RYhJCvPzZg";
const legacyApiUrl = import.meta.env.PUBLIC_LEGACY_API_URL ?? "https://api.kaianolevine.com";

const socials = [
  { label: "Facebook (Personal)", href: "https://www.facebook.com/kaiano.levine" },
  { label: "Facebook (Page)", href: "https://www.facebook.com/kaianolevinewcs/" },
  { label: "YouTube", href: "https://www.youtube.com/c/KaianoLevine" },
  { label: "Instagram", href: "https://www.instagram.com/kaiano.levine/" },
  { label: "Spotify", href: "https://open.spotify.com/user/1231335515" },
] as const;
---

<Page title="Contact" subtitle="Kaiano will get back to you in a flash!">
  <div class="space-y-10">
    <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 shadow-soft">

      <!-- Success state (hidden by default) -->
      <div id="contactSuccess" class="hidden space-y-2 py-6 text-center">
        <p class="font-serif italic text-2xl tracking-tight text-accent">Message sent!</p>
        <p class="text-sm text-slate-400">Kaiano will get back to you soon.</p>
      </div>

      <!-- Error state (hidden by default) -->
      <div id="contactError" class="mb-5 hidden rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3">
        <p class="text-sm text-red-400" id="contactErrorMsg">
          Something went wrong. Please refresh and try again.
        </p>
      </div>

      <form id="contactForm" class="space-y-5" novalidate>
        <input type="hidden" name="type" value="contact" />
        <input type="hidden" name="originSite" value="wcs.kaianolevine.com" />

        <!-- Honeypot -->
        <div style="display:none" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="space-y-1.5">
            <label for="firstName" class="text-xs font-medium uppercase tracking-widest text-slate-400">
              First name
            </label>
            <input
              id="firstName"
              type="text"
              name="firstName"
              required
              autocomplete="given-name"
              class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 transition-colors focus:border-white/25 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label for="lastName" class="text-xs font-medium uppercase tracking-widest text-slate-400">
              Last name
            </label>
            <input
              id="lastName"
              type="text"
              name="lastName"
              required
              autocomplete="family-name"
              class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 transition-colors focus:border-white/25 focus:outline-none"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="replyTo" class="text-xs font-medium uppercase tracking-widest text-slate-400">
            Reply-to email
          </label>
          <input
            id="replyTo"
            type="email"
            name="replyTo"
            required
            autocomplete="email"
            class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 transition-colors focus:border-white/25 focus:outline-none"
          />
        </div>

        <div class="space-y-1.5">
          <label for="message" class="text-xs font-medium uppercase tracking-widest text-slate-400">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 transition-colors focus:border-white/25 focus:outline-none"
          ></textarea>
          <p class="text-xs text-slate-500">
            This form is protected against spam. If submission fails, refresh and try again.
          </p>
        </div>

        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="dark"
        ></div>

        <button
          id="contactSubmit"
          type="submit"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5 font-mono text-sm font-semibold text-black transition-opacity hover:opacity-90 disabled:opacity-50"
        >
          <span id="contactSubmitLabel">Send →</span>
        </button>
      </form>
    </div>

    <section class="space-y-3">
      <h2 class="font-serif text-xl font-black italic tracking-tight" style="font-variation-settings: 'opsz' 72;">Other ways to connect</h2>
      <div class="flex flex-col gap-2">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noreferrer"
            class="text-sm text-blue-400 transition-colors hover:text-blue-300"
          >
            {s.label} ↗
          </a>
        ))}
      </div>
    </section>
  </div>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script define:vars={{ legacyApiUrl }}>
    const form = document.getElementById("contactForm");
    const submitBtn = document.getElementById("contactSubmit");
    const submitLabel = document.getElementById("contactSubmitLabel");
    const successEl = document.getElementById("contactSuccess");
    const errorEl = document.getElementById("contactError");
    const errorMsg = document.getElementById("contactErrorMsg");

    if (form && submitBtn && successEl && errorEl) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Hide any previous error
        errorEl.classList.add("hidden");

        // Basic client-side validation
        const data = new FormData(form);
        if (!data.get("firstName") || !data.get("replyTo") || !data.get("message")) {
          errorMsg.textContent = "Please fill in all required fields.";
          errorEl.classList.remove("hidden");
          return;
        }

        submitBtn.disabled = true;
        submitLabel.textContent = "Sending…";

        try {
          const res = await fetch(`${legacyApiUrl}/v1/contact`, {
            method: "POST",
            body: data,
            redirect: "manual",
          });

          const isRedirect = res.type === "opaqueredirect";
          const isSuccess = res.ok || isRedirect;

          if (!isSuccess) {
            const text = await res.text().catch(() => "");
            throw new Error(text || `Error ${res.status}`);
          }

          // Show success, hide form
          form.classList.add("hidden");
          successEl.classList.remove("hidden");
        } catch (err) {
          errorMsg.textContent =
            err instanceof Error ? err.message : "Something went wrong. Please try again.";
          errorEl.classList.remove("hidden");
          submitBtn.disabled = false;
          submitLabel.textContent = "Send →";
        }
      });
    }
  </script>
</Page>
