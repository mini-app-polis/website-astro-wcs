---
import Page from "../../layouts/Page.astro";
import TrackTable from "../../components/TrackTable.astro";
import { getSetDetail, getSets, getApiBase } from "../../lib/api";

// Public, enumerable, so it is rendered at build time. Sets are a public
// resource and /v1/sets already lists them, which makes getStaticPaths the
// honest expression of this page: a static rendering of things that exist.
//
// A set added after a build does not appear until the next one. That is the
// same shape as kwalla-dance's calendar, and the same answer applies — a
// scheduled Cloudflare deploy hook.
//
// The private note routes deliberately do NOT do this. Enumerating them at
// build time would publish the id set and bake private paths into a public
// artifact; they are served as shells instead and fetch with a credential.
export async function getStaticPaths() {
  const apiBase = getApiBase();

  if (!apiBase) {
    // Offline or local build with no API configured. Emit nothing rather than
    // failing, but say so — a deploy that reaches this branch ships a site
    // where every /sets/<id> is a 404.
    console.warn(
      "[sets] KAIANO_API_BASE_URL is not set — building with no set detail pages.",
    );
    return [];
  }

  const sets = await getSets({ limit: 1000 }, apiBase);

  // getSets swallows transport errors and returns its fallback, so an API
  // blip during a build would otherwise produce a green build that silently
  // 404s every set. A configured API returning nothing is a failure, not an
  // empty catalogue — refuse to publish it.
  if (!sets?.length) {
    throw new Error(
      `[sets] ${apiBase}/v1/sets returned no sets. Refusing to build, because ` +
        "this would publish a site where every set detail page is missing.",
    );
  }

  return sets.map((s) => ({ params: { id: String(s.id) } }));
}

const { id } = Astro.params;
const apiBase = getApiBase();
const set = apiBase ? await getSetDetail(String(id), apiBase) : null;

// getStaticPaths only emits ids the list returned, so this is a guard against
// a set disappearing mid-build rather than an expected branch.
if (!set) return Astro.redirect("/sets");

const dateFmt = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<Page title={set.venue} subtitle={`${set.tracks.length} tracks`}>
  <div class="space-y-4">
    <a
      href="/sets"
      class="inline-flex items-center gap-2 text-sm font-medium text-slate-400 transition-colors hover:text-accent"
    >
      <span class="font-mono">←</span>
      Full History
    </a>

    <p class="font-mono text-sm text-slate-400">
      {dateFmt.format(new Date(set.set_date))}
    </p>

    <TrackTable tracks={set.tracks} />
  </div>
</Page>
