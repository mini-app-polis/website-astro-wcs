---
import Page from "../../layouts/Page.astro";
import { getApiBase } from "../../lib/api";

// One year's summary — its numbers and its full song list — fetched at
// request time like sets/detail: everything is computed by the API from that
// year's sets, so the current year's page moves as sets land without a
// rebuild.
const apiBase = getApiBase();

const tiles = [
  { key: "set_count", label: "Sets" },
  { key: "songs_played", label: "Songs Played" },
  { key: "unique_songs", label: "Unique Songs" },
  { key: "hours", label: "Hours Played" },
  { key: "songs_played_once", label: "Played Once" },
  { key: "new_songs", label: "New This Year" },
  { key: "avg_set", label: "Avg Set Length" },
  { key: "avg_song", label: "Avg Song Length" },
] as const;

// The year's full song list, as the original summary sheets carried it.
// Columns hidden on small screens are the ones a reader scans least.
const columns = [
  { key: "rank", label: "#", cls: "w-10", sort: null },
  { key: "title", label: "Title", cls: "", sort: "title" },
  { key: "artist", label: "Artist", cls: "", sort: "artist" },
  { key: "genre", label: "Genre", cls: "hidden lg:table-cell", sort: "genre" },
  { key: "bpm", label: "BPM", cls: "hidden md:table-cell", sort: "bpm" },
  { key: "release_year", label: "Year", cls: "hidden md:table-cell", sort: "release_year" },
  { key: "length_secs", label: "Length", cls: "hidden lg:table-cell", sort: "length_secs" },
  { key: "play_count", label: "Plays", cls: "text-right", sort: "play_count" },
  { key: "total_play_secs", label: "Play Time", cls: "hidden sm:table-cell text-right", sort: "total_play_secs" },
] as const;
---

<Page title="Year Summary">
  <div class="space-y-6" data-summary data-api-base={apiBase}>
    <a
      data-summary-back
      href="/sets"
      class="inline-flex items-center gap-2 text-sm font-medium text-slate-400 transition-colors hover:text-accent"
    >
      <span class="font-mono">←</span>
      <span data-summary-back-label>Full History</span>
    </a>

    <p class="font-mono text-sm text-slate-400" data-summary-status></p>

    <div data-summary-loading class="text-sm text-slate-500">Loading…</div>
    <div data-summary-error class="hidden text-sm text-slate-500"></div>

    <div data-summary-body class="hidden space-y-6">
      <section class="rounded-2xl border border-white/[0.07] bg-surface p-6">
        <div class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4">
          {tiles.map((t) => (
            <div class="text-center" data-tile={t.key}>
              <div class="stat-value font-serif text-3xl font-bold italic text-accent sm:text-4xl">—</div>
              <div class="mt-1 text-xs font-medium uppercase tracking-widest text-slate-400">{t.label}</div>
            </div>
          ))}
        </div>
        <p data-summary-footnote class="mt-5 hidden text-center text-xs text-slate-500"></p>
      </section>

      <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface" data-songs>
        <div class="flex flex-wrap items-end justify-between gap-4 p-6 pb-4">
          <div>
            <h2 class="font-serif text-xl font-black italic tracking-tight" style="font-variation-settings: 'opsz' 72;">Every Song</h2>
            <p class="mt-1 text-sm text-slate-400">
              <span data-songs-count>—</span> songs · versions merged · most played first
            </p>
          </div>
          <input
            type="search"
            data-songs-filter
            placeholder="Filter by title, artist or genre"
            aria-label="Filter songs"
            class="w-full rounded-full border border-white/[0.07] bg-surface2 px-4 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-accent/60 focus:outline-none sm:w-72"
          />
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-y border-white/[0.07] text-xs uppercase tracking-widest text-slate-400">
              <tr>
                {columns.map((c) => (
                  <th scope="col" class={`whitespace-nowrap px-3 py-3 font-medium first:pl-6 last:pr-6 ${c.cls}`}>
                    {c.sort ? (
                      <button type="button" data-sort={c.sort} class="uppercase tracking-widest transition-colors hover:text-accent data-[active=true]:text-accent">
                        {c.label}
                      </button>
                    ) : c.label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody data-songs-body>
              <tr><td colspan={columns.length} class="px-5 py-8 text-center text-slate-500">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Page>

<script type="module">
  const root = document.querySelector("[data-summary]");
  if (!root) throw new Error("[summary] missing [data-summary] wrapper");
  const base = (root.dataset.apiBase ?? "").replace(/\/$/, "");
  const year = Number(new URLSearchParams(location.search).get("year"));

  const loadingEl = root.querySelector("[data-summary-loading]");
  const errorEl = root.querySelector("[data-summary-error]");
  const bodyEl = root.querySelector("[data-summary-body]");
  const statusEl = root.querySelector("[data-summary-status]");

  const nf = new Intl.NumberFormat("en-US");
  const dateFmt = new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });

  const clock = (secs) => {
    if (secs == null) return "—";
    const h = Math.floor(secs / 3600);
    const m = Math.floor((secs % 3600) / 60);
    const s = secs % 60;
    return h
      ? `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`
      : `${m}:${String(s).padStart(2, "0")}`;
  };

  // A total from partial lengths is a floor, marked "+" — unless under half
  // the plays have one, where a floor misleads.
  function hours(s) {
    if (s.hours_played_secs == null || s.length_coverage < 0.5) return "—";
    const h = Math.round(s.hours_played_secs / 3600);
    return s.length_coverage < 1 ? `${nf.format(h)}+` : nf.format(h);
  }

  function fail(message) {
    loadingEl.classList.add("hidden");
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  function setTile(key, value) {
    const el = root.querySelector(`[data-tile="${key}"] .stat-value`);
    if (el) el.textContent = value;
  }

  // The song table. textContent throughout — titles and artists are
  // arbitrary strings from the catalogue and must never be parsed as markup.
  const songsRoot = root.querySelector("[data-songs]");
  const songsBody = songsRoot.querySelector("[data-songs-body]");
  const COLUMN_CLASSES = [
    "whitespace-nowrap px-3 py-3 font-mono text-slate-500",
    "py-3 pl-3 pr-3 font-medium text-slate-100",
    "px-3 py-3 text-slate-300",
    "hidden px-3 py-3 text-slate-400 lg:table-cell",
    "hidden whitespace-nowrap px-3 py-3 font-mono text-slate-400 md:table-cell",
    "hidden whitespace-nowrap px-3 py-3 font-mono text-slate-400 md:table-cell",
    "hidden whitespace-nowrap px-3 py-3 font-mono text-slate-400 lg:table-cell",
    "whitespace-nowrap px-3 py-3 text-right font-mono text-accent",
    "hidden whitespace-nowrap px-3 py-3 text-right font-mono text-slate-400 sm:table-cell",
  ];
  let songs = [];
  let sortKey = "play_count";
  let sortDesc = true;
  let filterText = "";

  function songCells(r, i) {
    return [
      String(i + 1),
      r.remix ? `${r.title} (${r.remix})` : r.title,
      r.artist,
      r.genre ?? "—",
      r.bpm == null ? "—" : String(Math.round(r.bpm)),
      r.release_year == null ? "—" : String(r.release_year),
      clock(r.length_secs),
      nf.format(r.play_count),
      clock(r.total_play_secs),
    ];
  }

  function compare(a, b) {
    const x = a[sortKey];
    const y = b[sortKey];
    // Blanks sink to the bottom whichever way the column is sorted.
    if (x == null && y == null) return 0;
    if (x == null) return 1;
    if (y == null) return -1;
    const c = typeof x === "string"
      ? x.localeCompare(y, undefined, { sensitivity: "base" })
      : x - y;
    return sortDesc ? -c : c;
  }

  function renderSongs() {
    const q = filterText.trim().toLowerCase();
    const rows = (q
      ? songs.filter((r) =>
          [r.title, r.remix, r.artist, r.genre].some((v) => v && v.toLowerCase().includes(q)))
      : songs.slice()
    ).sort((a, b) => compare(a, b) || b.play_count - a.play_count || a.title.localeCompare(b.title));

    songsRoot.querySelectorAll("[data-sort]").forEach((btn) => {
      const active = btn.dataset.sort === sortKey;
      btn.dataset.active = String(active);
      btn.closest("th")?.setAttribute("aria-sort", active ? (sortDesc ? "descending" : "ascending") : "none");
    });

    songsBody.innerHTML = "";
    if (!rows.length) {
      const tr = document.createElement("tr");
      const td = document.createElement("td");
      td.colSpan = COLUMN_CLASSES.length;
      td.className = "px-5 py-8 text-center text-slate-500";
      td.textContent = songs.length ? "No songs match that filter." : "No songs on record for this year.";
      tr.append(td);
      songsBody.append(tr);
      return;
    }
    const frag = document.createDocumentFragment();
    rows.forEach((r, i) => {
      const tr = document.createElement("tr");
      tr.className = i % 2 ? "bg-white/[0.02]" : "";
      songCells(r, i).forEach((text, c) => {
        const td = document.createElement("td");
        td.className = COLUMN_CLASSES[c] + (c === 0 ? " pl-6" : c === COLUMN_CLASSES.length - 1 ? " pr-6" : "");
        td.textContent = text;
        tr.append(td);
      });
      frag.append(tr);
    });
    songsBody.append(frag);
  }

  songsRoot.addEventListener("click", (e) => {
    const btn = e.target?.closest?.("[data-sort]");
    if (!btn) return;
    const key = btn.dataset.sort;
    // Text columns start A→Z; numeric columns start highest first.
    sortDesc = key === sortKey ? !sortDesc : !["title", "artist", "genre"].includes(key);
    sortKey = key;
    renderSongs();
  });
  songsRoot.querySelector("[data-songs-filter]").addEventListener("input", (e) => {
    filterText = e.target.value;
    renderSongs();
  });

  async function loadSongs() {
    try {
      const res = await fetch(`${base}/v1/stats/summaries/${year}/songs`, { cache: "no-store" });
      if (!res.ok) throw new Error(String(res.status));
      songs = (await res.json())?.data ?? [];
      songsRoot.querySelector("[data-songs-count]").textContent = nf.format(songs.length);
      renderSongs();
    } catch {
      songsBody.innerHTML = "";
      const tr = document.createElement("tr");
      const td = document.createElement("td");
      td.colSpan = COLUMN_CLASSES.length;
      td.className = "px-5 py-8 text-center text-slate-500";
      td.textContent = "Could not load the song list.";
      tr.append(td);
      songsBody.append(tr);
    }
  }

  function render(s) {
    document.title = `${s.year} Summary — Kaiano Levine`;
    const heading = document.querySelector("h1");
    if (heading) heading.textContent = `${s.year} Summary`;

    const back = root.querySelector("[data-summary-back]");
    back.href = `/sets?year=${s.year}`;
    root.querySelector("[data-summary-back-label]").textContent = `${s.year} sets`;

    statusEl.textContent =
      s.status === "in_progress"
        ? `In progress · through ${dateFmt.format(new Date(s.last_set_date))}`
        : `${dateFmt.format(new Date(s.first_set_date))} – ${dateFmt.format(new Date(s.last_set_date))}`;

    setTile("set_count", nf.format(s.set_count));
    setTile("songs_played", nf.format(s.songs_played));
    setTile("unique_songs", nf.format(s.unique_songs));
    setTile("hours", hours(s));
    setTile("songs_played_once", nf.format(s.songs_played_once));
    setTile("new_songs", nf.format(s.new_songs));
    // Averages only when every play has a length; a partial one misleads.
    const full = s.length_coverage >= 1;
    setTile("avg_set", full ? clock(s.avg_set_length_secs) : "—");
    setTile("avg_song", full ? clock(s.avg_song_length_secs) : "—");

    const footnote = root.querySelector("[data-summary-footnote]");
    if (s.status === "in_progress") {
      footnote.textContent = "This year is still going — the summary updates as sets are added.";
      footnote.classList.remove("hidden");
    }

  }

  async function load() {
    if (!Number.isInteger(year) || year <= 0) return fail("No year selected.");
    if (!base) return fail("Could not load this summary.");
    try {
      const res = await fetch(`${base}/v1/stats/summaries/${year}`, { cache: "no-store" });
      if (res.status === 404) return fail(`No sets on record for ${year}.`);
      if (!res.ok) return fail("Could not load this summary.");
      const s = (await res.json())?.data;
      if (!s) return fail("Could not load this summary.");
      render(s);
      loadingEl.classList.add("hidden");
      bodyEl.classList.remove("hidden");
      loadSongs();
    } catch {
      fail("Could not load this summary.");
    }
  }

  load();
</script>
