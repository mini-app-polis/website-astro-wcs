---
import Page from "../../layouts/Page.astro";
---

<Page title="Locate" subtitle="Where is Kaiano dancing and DJing?">
  <!--
    Google Calendar doesn't support dark mode natively.
    The iframe is wrapped in a slightly lightened container so it
    doesn't clash with the dark page background. The ?color param
    below uses Google's "Graphite" theme which is the closest neutral.
    Swap the src `color` param to match any future rebranding.
  -->
  <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]">
    <iframe
      src="https://calendar.google.com/calendar/embed?height=700&wkst=1&ctz=America%2FChicago&showPrint=0&showCalendars=0&showTitle=0&src=a2didHZuYXRtZmNzNmhoaGh1dXR1MDY3dnNAZ3JvdXAuY2FsZW5kYXIuZ29vZ2xlLmNvbQ&color=%23616161"
      style="border: 0; width: 100%; height: 700px; display: block;"
      frameborder="0"
      scrolling="no"
      title="Kaiano Levine Event Calendar"
    ></iframe>
  </div>
  <p class="mt-3 text-xs text-slate-500">
    All times shown in America/Chicago (CT).
  </p>
</Page>
