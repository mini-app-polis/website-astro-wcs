---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Not Found">
  <div class="flex min-h-[40vh] flex-col items-center justify-center gap-4 text-center">
    <p class="font-mono text-6xl font-semibold text-slate-700">404</p>
    <p class="text-slate-400">Page not found.</p>
    <a
      href="/"
      class="mt-2 font-mono text-sm text-accent transition-colors hover:text-accent/80"
    >
      ← Home
    </a>
  </div>
</Base>
