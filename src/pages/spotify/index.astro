---
import Page from "../../layouts/Page.astro";
---

<Page title="Spotify" subtitle="Playlists for the WCS community">
  <div class="space-y-6">
    <a
      href="https://open.spotify.com/user/31oya3ie2f5wwlqt6tnfurou6zzq"
      target="_blank"
      rel="noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5 font-mono text-sm font-semibold text-black transition-opacity hover:opacity-90"
    >
      Spotify Profile ↗
    </a>

    <p class="max-w-xl text-sm italic leading-relaxed text-slate-500">
      Disclaimer: I personally do not endorse or actively support the Spotify platform.
      This page exists solely as a tool to help dancers discover music and find songs
      that support their growth and creativity within the dance community.
    </p>

    <!-- Playlists rendered by kaiano-api Spotify snapshot JSON -->
    <section
      class="rounded-2xl border border-white/10 bg-white/[0.02] p-6"
      data-spotify-playlists
    >
      <h2 class="font-display text-xl tracking-tight">Playlists</h2>
      <p class="mt-1 text-sm text-slate-400">
        Pulled from <span class="font-mono">kaiano-api</span> Spotify snapshot
      </p>

      <div
        class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
        data-playlists-grid
      >
        {Array.from({ length: 6 }).map(() => (
          <div class="space-y-2">
            <div class="aspect-square w-full animate-pulse rounded-xl bg-white/10" />
            <div class="h-4 w-3/4 animate-pulse rounded bg-white/10" />
            <div class="h-3 w-1/2 animate-pulse rounded bg-white/10" />
          </div>
        ))}
      </div>

      <p data-playlists-error class="mt-4 hidden text-sm text-slate-400">
        Unable to load playlists
      </p>
    </section>
  </div>

  <script type="module">
    // kaiano-api exposes Spotify playlist snapshots at /api/v1/spotify/playlists
    // Adjust the endpoint path to match your actual kaiano-api route.
    const root = document.querySelector("[data-spotify-playlists]");
    if (!root) throw new Error("Spotify root not found");

    const grid = root.querySelector("[data-playlists-grid]");
    const errorEl = root.querySelector("[data-playlists-error]");

    const BASE = document.documentElement.dataset.apiUrl || "";

    async function loadPlaylists() {
      if (!BASE) {
        showError();
        return;
      }
      try {
        const res = await fetch(
          `${String(BASE).replace(/\/$/, "")}/v1/spotify/playlists`,
          { cache: "no-store" },
        );
        if (!res.ok) throw new Error(`Bad response: ${res.status}`);
        const json = await res.json();
        const playlists = json?.data ?? json;
        if (!Array.isArray(playlists) || playlists.length === 0) throw new Error("Empty");

        if (!grid) return;
        grid.innerHTML = "";

        playlists.forEach((pl, i) => {
          const card = document.createElement("a");
          card.href = pl.external_url ?? pl.url ?? "#";
          card.target = "_blank";
          card.rel = "noreferrer";
          card.className = "group space-y-2 reveal";
          card.style.setProperty("--d", `${i * 60}ms`);

          const imgWrap = document.createElement("div");
          imgWrap.className = "overflow-hidden rounded-xl border border-white/10";

          if (pl.image_url ?? pl.image) {
            const img = document.createElement("img");
            img.src = pl.image_url ?? pl.image;
            img.alt = pl.name ?? "Playlist";
            img.className = "aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105";
            imgWrap.appendChild(img);
          } else {
            imgWrap.className += " bg-white/[0.04]";
            imgWrap.style.aspectRatio = "1";
          }

          const name = document.createElement("p");
          name.className = "text-sm font-medium text-slate-100 transition-colors group-hover:text-accent";
          name.textContent = pl.name ?? "Playlist";

          const count = document.createElement("p");
          count.className = "font-mono text-xs text-slate-500";
          count.textContent = pl.track_count != null ? `${pl.track_count} songs` : "";

          card.appendChild(imgWrap);
          card.appendChild(name);
          card.appendChild(count);
          grid.appendChild(card);
        });
      } catch {
        showError();
      }
    }

    function showError() {
      if (!grid || !errorEl) return;
      grid.innerHTML = "";
      errorEl.classList.remove("hidden");
    }

    loadPlaylists();
  </script>
</Page>
