---
import Base from "./Base.astro";

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<Base title={title} description={subtitle ?? title}>
  <section class="space-y-5">
    <header>
      <h1 class="font-display text-4xl font-black italic tracking-tight sm:text-5xl" style="font-variation-settings: 'opsz' 72;">
        {title}
      </h1>
      {subtitle ? (
        <p class="mt-2 text-sm font-light text-slate-400">{subtitle}</p>
      ) : null}
    </header>
    <div class="pt-2">
      <slot />
    </div>
  </section>
</Base>
